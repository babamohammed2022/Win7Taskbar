<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- Deutsch -->
    <s:String x:Key="lang_show_hidden">Ausgeblendete Symbole anzeigen</s:String>
    <s:String x:Key="lang_start_tip">Start</s:String>
    <s:String x:Key="lang_taskbar">Taskleiste</s:String>
    <s:String x:Key="lang_show_seconds">Sekunden in der Uhr anzeigen</s:String>
    <s:String x:Key="lang_show_seconds_desc">Wenn aktiviert, wird die Uhr jede Sekunde aktualisiert, sonst jede Minute.</s:String>
    <s:String x:Key="lang_clock_flyout">Uhr-Flyout</s:String>
    <s:String x:Key="lang_clock_flyout_desc">Normalerweise wird das echte Windows-Flyout verwendet. Stellt das System es nicht bereit, wird automatisch auf das nachgebaute zurückgegriffen.</s:String>
    <s:String x:Key="lang_clock_label">Uhr:</s:String>
    <s:String x:Key="lang_clock_w7">Klassisches Thema (nachgebildet)</s:String>
    <s:String x:Key="lang_clock_native">Windows 7</s:String>
    <s:String x:Key="lang_close_desc">Beim Schließen von Win7Taskbar wird die Windows-Taskleiste wiederhergestellt.</s:String>
    <s:String x:Key="lang_close_button">Win7Taskbar schließen</s:String>
    <s:String x:Key="lang_close_confirm">Win7Taskbar schließen und die Windows-Taskleiste wiederherstellen?</s:String>
    <s:String x:Key="lang_properties_title">Eigenschaften - Win7Taskbar</s:String>
    <s:String x:Key="lang_ok">OK</s:String>
    <s:String x:Key="lang_cancel">Abbrechen</s:String>
    <s:String x:Key="lang_language">Sprache:</s:String>
    <s:String x:Key="lang_language_desc">Sprache der Benutzeroberfläche auswählen.</s:String>
    <s:String x:Key="lang_italian">Italiano</s:String>
    <s:String x:Key="lang_english">English</s:String>
    <s:String x:Key="lang_customize">Anpassen...</s:String>
    <s:String x:Key="lang_show_desktop">Desktop anzeigen</s:String>
    <s:String x:Key="lang_peek_desktop">Peek auf den Desktop</s:String>
    <s:String x:Key="lang_edit_datetime">Datum/Uhrzeit anpassen</s:String>
    <s:String x:Key="lang_customize_notify">Infobereich anpassen...</s:String>
    <s:String x:Key="lang_task_manager">Task-Manager starten</s:String>
    <s:String x:Key="lang_properties">Eigenschaften</s:String>
    <s:String x:Key="lang_minimize_group">Gruppe minimieren</s:String>
    <s:String x:Key="lang_close_group">Gruppe schließen</s:String>
    <s:String x:Key="lang_appsearch">App-Suche</s:String>
    <s:String x:Key="lang_appsearch_desc">App-Suche (optionale Neuimplementierung, inspiriert von Windows Search)</s:String>
    <s:String x:Key="lang_appsearch_note">Sie ist weder die Systemsuche noch ein offizieller Ersatz: Sie listet nur die Verknüpfungen des Startmenüs auf. Sie kann in den Eigenschaften deaktiviert werden.</s:String>
    <s:String x:Key="lang_appsearch_open">Suche öffnen</s:String>
    <s:String x:Key="lang_about_title">Über</s:String>
    <s:String x:Key="lang_about_text">Win7Taskbar ist ein Best-Effort-Projekt in ständiger Verbesserung, das die Windows-7-Taskleiste über der modernen nachbildet: Die Genauigkeit wird sich mit der Zeit verbessern. Bekannte Einschränkungen: Das Drehen der Taskleiste (seitlich/oben) wird nicht unterstützt, die entsprechende Option ist daher derzeit nur dekorativ; Systemfenster (Flyouts, Startmenü) werden angeheftet und neu positioniert, nicht nachgebaut.</s:String>
    <s:String x:Key="lang_credits">Danksagung: 3ds für einige der Grafikressourcen und für die Inspiration hinter der XAML-Idee.</s:String>
</ResourceDictionary>
