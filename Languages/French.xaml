<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- Français -->
    <s:String x:Key="lang_show_hidden">Afficher les icônes cachées</s:String>
    <s:String x:Key="lang_start_tip">Démarrer</s:String>
    <s:String x:Key="lang_taskbar">Barre des tâches</s:String>
    <s:String x:Key="lang_show_seconds">Afficher les secondes dans l'horloge</s:String>
    <s:String x:Key="lang_show_seconds_desc">Lorsque l'option est activée, l'horloge se met à jour chaque seconde, sinon chaque minute.</s:String>
    <s:String x:Key="lang_clock_flyout">Panneau de l'horloge</s:String>
    <s:String x:Key="lang_clock_flyout_desc">Normalement, le vrai panneau de Windows est utilisé. Si le système ne le fournit pas, il bascule automatiquement sur celui qui est recréé.</s:String>
    <s:String x:Key="lang_clock_label">Horloge :</s:String>
    <s:String x:Key="lang_clock_w7">Thème classique (recréé)</s:String>
    <s:String x:Key="lang_clock_native">Windows 7</s:String>
    <s:String x:Key="lang_close_desc">La fermeture de Win7Taskbar restaurera la barre des tâches de Windows.</s:String>
    <s:String x:Key="lang_close_button">Fermer Win7Taskbar</s:String>
    <s:String x:Key="lang_close_confirm">Fermer Win7Taskbar et restaurer la barre des tâches de Windows ?</s:String>
    <s:String x:Key="lang_properties_title">Propriétés - Win7Taskbar</s:String>
    <s:String x:Key="lang_ok">OK</s:String>
    <s:String x:Key="lang_cancel">Annuler</s:String>
    <s:String x:Key="lang_language">Langue :</s:String>
    <s:String x:Key="lang_language_desc">Sélectionnez la langue de l'interface.</s:String>
    <s:String x:Key="lang_italian">Italiano</s:String>
    <s:String x:Key="lang_english">English</s:String>
    <s:String x:Key="lang_customize">Personnaliser...</s:String>
    <s:String x:Key="lang_show_desktop">Afficher le Bureau</s:String>
    <s:String x:Key="lang_peek_desktop">Aperçu du Bureau</s:String>
    <s:String x:Key="lang_edit_datetime">Ajuster la date et l'heure</s:String>
    <s:String x:Key="lang_customize_notify">Personnaliser la zone de notification...</s:String>
    <s:String x:Key="lang_task_manager">Lancer le Gestionnaire des tâches</s:String>
    <s:String x:Key="lang_properties">Propriétés</s:String>
    <s:String x:Key="lang_minimize_group">Réduire le groupe</s:String>
    <s:String x:Key="lang_close_group">Fermer le groupe</s:String>
    <s:String x:Key="lang_appsearch">Recherche d'applications</s:String>
    <s:String x:Key="lang_appsearch_desc">Recherche d'applications (réimplémentation optionnelle, inspirée de Windows Search)</s:String>
    <s:String x:Key="lang_appsearch_note">Ce n'est pas la recherche système ni un remplaçant officiel : elle liste uniquement les raccourcis du menu Démarrer. Elle peut être désactivée dans les Propriétés.</s:String>
    <s:String x:Key="lang_appsearch_open">Ouvrir la recherche</s:String>
    <s:String x:Key="lang_about_title">À propos</s:String>
    <s:String x:Key="lang_about_text">Win7Taskbar est un projet best-effort en amélioration constante qui recrée la barre des tâches de Windows 7 par-dessus la barre moderne : la précision s'améliorera avec le temps. Limitations connues : la rotation de la barre des tâches (côtés/haut) n'est pas prise en charge, l'option correspondante est donc actuellement décorative ; les fenêtres système (panneaux, menu Démarrer) sont accrochées et repositionnées, pas recréées.</s:String>
    <s:String x:Key="lang_credits">Crédits : 3ds pour certaines ressources graphiques et pour l'inspiration de l'idée XAML.</s:String>
</ResourceDictionary>
