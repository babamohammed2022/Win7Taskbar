<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- 日本語 -->
    <s:String x:Key="lang_show_hidden">隠しアイコンを表示</s:String>
    <s:String x:Key="lang_start_tip">スタート</s:String>
    <s:String x:Key="lang_taskbar">タスクバー</s:String>
    <s:String x:Key="lang_show_seconds">時計に秒を表示する</s:String>
    <s:String x:Key="lang_show_seconds_desc">有効にすると、時計は毎秒更新されます。無効の場合は毎分更新されます。</s:String>
    <s:String x:Key="lang_clock_flyout">時計のフライアウト</s:String>
    <s:String x:Key="lang_clock_flyout_desc">通常は Windows 本来のフライアウトが使われます。システムが提供しない場合は、再現されたものに自動的に切り替わります。</s:String>
    <s:String x:Key="lang_clock_label">時計:</s:String>
    <s:String x:Key="lang_clock_w7">クラシックテーマ（再現）</s:String>
    <s:String x:Key="lang_clock_native">Windows 7</s:String>
    <s:String x:Key="lang_close_desc">Win7Taskbar を閉じると、Windows のタスクバーが復元されます。</s:String>
    <s:String x:Key="lang_close_button">Win7Taskbar を閉じる</s:String>
    <s:String x:Key="lang_close_confirm">Win7Taskbar を閉じて、Windows のタスクバーを復元しますか？</s:String>
    <s:String x:Key="lang_properties_title">プロパティ - Win7Taskbar</s:String>
    <s:String x:Key="lang_ok">OK</s:String>
    <s:String x:Key="lang_cancel">キャンセル</s:String>
    <s:String x:Key="lang_language">言語:</s:String>
    <s:String x:Key="lang_language_desc">インターフェイスの言語を選択してください。</s:String>
    <s:String x:Key="lang_italian">Italiano</s:String>
    <s:String x:Key="lang_english">English</s:String>
    <s:String x:Key="lang_customize">カスタマイズ...</s:String>
    <s:String x:Key="lang_show_desktop">デスクトップの表示</s:String>
    <s:String x:Key="lang_peek_desktop">デスクトップのプレビュー表示</s:String>
    <s:String x:Key="lang_edit_datetime">日付と時刻の調整</s:String>
    <s:String x:Key="lang_customize_notify">通知領域のカスタマイズ...</s:String>
    <s:String x:Key="lang_task_manager">タスク マネージャーの起動</s:String>
    <s:String x:Key="lang_properties">プロパティ</s:String>
    <s:String x:Key="lang_minimize_group">グループを最小化</s:String>
    <s:String x:Key="lang_close_group">グループを閉じる</s:String>
    <s:String x:Key="lang_appsearch">アプリ検索</s:String>
    <s:String x:Key="lang_appsearch_desc">アプリ検索（Windows Search に着想した任意の再実装）</s:String>
    <s:String x:Key="lang_appsearch_note">これはシステムの検索ではなく、公式の代替でもありません。スタート メニューのショートカットのみを一覧表示します。プロパティから無効にできます。</s:String>
    <s:String x:Key="lang_appsearch_open">検索を開く</s:String>
    <s:String x:Key="lang_about_title">概要</s:String>
    <s:String x:Key="lang_about_text">Win7Taskbar は、最新のタスクバーの上に Windows 7 のタスクバーを再現する、常に改良中のベストエフォート型プロジェクトです。精度は時間とともに向上します。既知の制限：タスクバーの回転（横・上）には対応していないため、関連するオプションは現在装飾的なものです。システムウィンドウ（フライアウト、スタートメニュー）はフックして再配置するものであり、再現するものではありません。</s:String>
    <s:String x:Key="lang_credits">クレジット：一部のグラフィックリソースおよび XAML アイデアの着想について 3ds に感謝します。</s:String>
    <s:String x:Key="lang_menu_toolbars">ツールバー</s:String>
    <s:String x:Key="lang_menu_desktop">デスクトップ</s:String>
    <s:String x:Key="lang_menu_links">リンク</s:String>
    <s:String x:Key="lang_menu_address">アドレス</s:String>
    <s:String x:Key="lang_menu_cascade">重ねて表示</s:String>
    <s:String x:Key="lang_menu_stack">ウィンドウを上下に並べて表示</s:String>
    <s:String x:Key="lang_menu_sidebyside">ウィンドウを左右に並べて表示</s:String>
    <s:String x:Key="lang_menu_lock">タスクバーを固定する</s:String>
    <s:String x:Key="lang_menu_pin">このプログラムをタスクバーにピン留めする</s:String>
    <s:String x:Key="lang_menu_unpin">このプログラムをタスクバーからピン留めを解除する</s:String>
    <s:String x:Key="lang_address_tip">アドレス: パスまたは URL を入力して Enter キーを押します</s:String>
    <s:String x:Key="lang_tray_pin_tip">トレイとオーバーフローの間で移動 (ピン留め/解除)</s:String>
    <s:String x:Key="lang_close_tip">閉じる</s:String>
    <!-- v1.21.7: the only managed string of the extra settings section -->
    <s:String x:Key="lang_icon_order_drag_hint">ドロップして順序を変更</s:String>
</ResourceDictionary>
