                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- English -->
    <s:String x:Key="lang_show_hidden">Show hidden icons</s:String>
    <s:String x:Key="lang_start_tip">Start</s:String>
    <s:String x:Key="lang_taskbar">Taskbar</s:String>
    <s:String x:Key="lang_show_seconds">Show seconds in clock</s:String>
    <s:String x:Key="lang_show_seconds_desc">When enabled, the clock updates every second, otherwise every minute.</s:String>
    <s:String x:Key="lang_clock_flyout">Clock flyout</s:String>
    <s:String x:Key="lang_clock_flyout_desc">Normally the real Windows flyout is used. If the system doesn't provide it, it automatically falls back to the recreated one.</s:String>
    <s:String x:Key="lang_clock_label">Clock:</s:String>
    <s:String x:Key="lang_clock_w7">Classic theme (recreated)</s:String>
    <s:String x:Key="lang_clock_native">Windows 7</s:String>
    <s:String x:Key="lang_close_desc">Closing Win7Taskbar will restore the Windows taskbar.</s:String>
    <s:String x:Key="lang_close_button">Close Win7Taskbar</s:String>
    <s:String x:Key="lang_close_confirm">Close Win7Taskbar and restore Windows taskbar?</s:String>
    <s:String x:Key="lang_properties_title">Properties - Win7Taskbar</s:String>
    <s:String x:Key="lang_ok">OK</s:String>
