<!--
    Fumetto di notifica stile Windows 7.

    Viene mostrato quando un'applicazione chiama Shell_NotifyIconW con il flag
    NIF_INFO: e' la "nuvoletta" che spunta sopra l'area di notifica con titolo,
    testo e pulsante di chiusura.

    Tutta la grafica arriva dal tema dell'utente: lo stile NotifyBalloon disegna
    il riquadro e la punta triangolare, e ne gira automaticamente l'orientamento
    in base al bordo occupato dalla barra.

    Nota sulla "x" di chiusura: il tema originale la ottiene con il carattere
    "r" del font Marlett. Marlett c'e' su ogni Windows, ma se manca WPF non
    ripiega su un altro font: chiama Environment.FailFast e il processo muore
    senza eccezione. Qui la stessa crocetta e' disegnata come vettore, cosi' non
    dipende da nessun font installato.
-->
<UserControl x:Class="Win7Taskbar.Controls.NotifyBalloon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             MaxWidth="380">

    <ContentControl Style="{DynamicResource NotifyBalloon}">
        <StackPanel Orientation="Vertical">
            <DockPanel>
                <Image x:Name="BalloonIcon"
                       DockPanel.Dock="Left"
                       Style="{DynamicResource NotifyBalloonIcon}"
                       Source="{Binding IconSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Visibility="{Binding IconVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <Button x:Name="CloseButton"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource NotifyBalloonCloseButton}"
                        Click="CloseButton_Click"
                        ToolTip="Chiudi">
                    <Path Data="M 0,0 L 7,7 M 7,0 L 0,7"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Square"
                          StrokeEndLineCap="Square"
                          Width="7"
                          Height="7" />
                </Button>

                <TextBlock Style="{DynamicResource NotifyBalloonTitle}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           TextWrapping="Wrap" />
            </DockPanel>

            <TextBlock Style="{DynamicResource NotifyBalloonInfo}"
                       Text="{Binding Info, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ContentControl>
</UserControl>
