<UserControl x:Class="Win7Taskbar.Controls.TaskThumbnail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="202"
             Height="109"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <!-- The hover tooltip identifies the application; the parent preview
         title band deliberately continues to show the real window caption. -->
    <UserControl.ToolTip>
        <ToolTip Content="{Binding PlacementTarget.ApplicationName, RelativeSource={RelativeSource Self}}" />
    </UserControl.ToolTip>

    <!-- Normally this grid paints nothing: the compositor-owned DWM surface
         needs the destination left untouched. These children become visible
         only after the delayed DWM probe fails and the live thumbnail has
         first been unregistered. -->
    <Grid ClipToBounds="True">
        <Image x:Name="CaptureFallbackImage"
               Visibility="Collapsed"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Border x:Name="IdentityFallback"
                Visibility="Collapsed"
                Background="#D9202020">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="180">
                <Image Source="{Binding Icon}"
                       Width="32"
                       Height="32"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Title}"
                           Margin="6,7,6,0"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
