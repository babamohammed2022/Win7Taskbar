<UserControl x:Class="Win7Taskbar.Controls.TaskThumbnail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180"
             Height="120"
             Background="Transparent"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <UserControl.ToolTip>
        <ToolTip Content="{Binding PlacementTarget.Title, RelativeSource={RelativeSource Self}}" />
    </UserControl.ToolTip>
</UserControl>
