<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- Русский -->
    <s:String x:Key="lang_show_hidden">Отображать скрытые значки</s:String>
    <s:String x:Key="lang_start_tip">Пуск</s:String>
    <s:String x:Key="lang_taskbar">Панель задач</s:String>
    <s:String x:Key="lang_show_seconds">Показывать секунды на часах</s:String>
    <s:String x:Key="lang_show_seconds_desc">Если включено, часы обновляются каждую секунду, иначе — каждую минуту.</s:String>
    <s:String x:Key="lang_clock_flyout">Панель часов</s:String>
    <s:String x:Key="lang_clock_flyout_desc">Обычно используется настоящая панель Windows. Если система её не предоставляет, автоматически используется воссозданная.</s:String>
    <s:String x:Key="lang_clock_label">Часы:</s:String>
    <s:String x:Key="lang_clock_w7">Классическая тема (воссоздано)</s:String>
    <s:String x:Key="lang_clock_native">Windows 7</s:String>
    <s:String x:Key="lang_close_desc">Закрытие Win7Taskbar восстановит панель задач Windows.</s:String>
    <s:String x:Key="lang_close_button">Закрыть Win7Taskbar</s:String>
    <s:String x:Key="lang_close_confirm">Закрыть Win7Taskbar и восстановить панель задач Windows?</s:String>
    <s:String x:Key="lang_properties_title">Свойства - Win7Taskbar</s:String>
    <s:String x:Key="lang_ok">ОК</s:String>
    <s:String x:Key="lang_cancel">Отмена</s:String>
    <s:String x:Key="lang_language">Язык:</s:String>
    <s:String x:Key="lang_language_desc">Выберите язык интерфейса.</s:String>
    <s:String x:Key="lang_italian">Italiano</s:String>
    <s:String x:Key="lang_english">English</s:String>
    <s:String x:Key="lang_customize">Настроить...</s:String>
    <s:String x:Key="lang_show_desktop">Показать рабочий стол</s:String>
    <s:String x:Key="lang_peek_desktop">Просмотр рабочего стола</s:String>
    <s:String x:Key="lang_edit_datetime">Настройка даты и времени</s:String>
    <s:String x:Key="lang_customize_notify">Настроить область уведомлений...</s:String>
    <s:String x:Key="lang_task_manager">Запустить диспетчер задач</s:String>
    <s:String x:Key="lang_properties">Свойства</s:String>
    <s:String x:Key="lang_minimize_group">Свернуть группу</s:String>
    <s:String x:Key="lang_close_group">Закрыть группу</s:String>
    <s:String x:Key="lang_appsearch">Поиск приложений</s:String>
    <s:String x:Key="lang_appsearch_desc">Поиск приложений (необязательная реимплементация по мотивам Поиска Windows)</s:String>
    <s:String x:Key="lang_appsearch_note">Это не системный поиск и не официальная замена: отображаются только ярлыки меню «Пуск». Поиск можно отключить в Свойствах.</s:String>
    <s:String x:Key="lang_appsearch_open">Открыть поиск</s:String>
    <s:String x:Key="lang_about_title">О программе</s:String>
    <s:String x:Key="lang_about_text">Win7Taskbar — это проект категории best-effort, который постоянно улучшается и воссоздаёт панель задач Windows 7 поверх современной: точность будет расти со временем. Известные ограничения: поворот панели задач (вбок/вверх) не поддерживается, поэтому соответствующая опция пока декоративная; системные окна (панели, меню «Пуск») перехватываются и перемещаются, а не воссоздаются.</s:String>
    <s:String x:Key="lang_credits">Благодарности: 3ds за часть графических ресурсов и за вдохновение идеей с XAML.</s:String>
</ResourceDictionary>
