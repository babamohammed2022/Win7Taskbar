<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- Arabic -->
    <s:String x:Key="lang_show_hidden">إظهار الأيقونات المخفية</s:String>
    <s:String x:Key="lang_start_tip">ابدأ</s:String>
    <s:String x:Key="lang_taskbar">شريط المهام</s:String>
    <s:String x:Key="lang_show_seconds">إظهار الثواني في الساعة</s:String>
    <s:String x:Key="lang_show_seconds_desc">عند التمكين، يتم تحديث الساعة كل ثانية، وإلا يتم تحديثها كل دقيقة.</s:String>
    <s:String x:Key="lang_clock_flyout">لوحة الساعة المنبثقة</s:String>
    <s:String x:Key="lang_clock_flyout_desc">يُستخدم عادةً flyout الخاص بنظام Windows. إذا لم يوفره النظام، يتم استخدام اللوحة المعاد إنشاؤها تلقائياً.</s:String>
    <s:String x:Key="lang_clock_label">الساعة:</s:String>
    <s:String x:Key="lang_clock_w7">السمة الكلاسيكية (معاد إنشاؤها)</s:String>
    <s:String x:Key="lang_clock_native">Windows 7</s:String>
    <s:String x:Key="lang_close_desc">سيؤدي إغلاق Win7Taskbar إلى استعادة شريط مهام Windows.</s:String>
    <s:String x:Key="lang_close_button">إغلاق Win7Taskbar</s:String>
    <s:String x:Key="lang_close_confirm">هل تريد إغلاق Win7Taskbar واستعادة شريط مهام Windows؟</s:String>
    <s:String x:Key="lang_properties_title">خصائص - Win7Taskbar</s:String>
    <s:String x:Key="lang_ok">موافق</s:String>
    <s:String x:Key="lang_cancel">إلغاء</s:String>
    <s:String x:Key="lang_language">اللغة:</s:String>
    <s:String x:Key="lang_language_desc">حدد لغة الواجهة.</s:String>
    <s:String x:Key="lang_italian">الإيطالية</s:String>
    <s:String x:Key="lang_english">الإنجليزية</s:String>
    <s:String x:Key="lang_customize">تخصيص...</s:String>
    <s:String x:Key="lang_show_desktop">إظهار سطح المكتب</s:String>
    <s:String x:Key="lang_peek_desktop">معاينة سطح المكتب</s:String>
    <s:String x:Key="lang_edit_datetime">ضبط التاريخ والوقت</s:String>
    <s:String x:Key="lang_customize_notify">تخصيص منطقة الإعلام...</s:String>
    <s:String x:Key="lang_task_manager">بدء تشغيل إدارة المهام</s:String>
    <s:String x:Key="lang_properties">خصائص</s:String>
    <s:String x:Key="lang_minimize_group">تصغير المجموعة</s:String>
    <s:String x:Key="lang_close_group">إغلاق المجموعة</s:String>
    <s:String x:Key="lang_appsearch">بحث التطبيقات</s:String>
    <s:String x:Key="lang_appsearch_desc">بحث التطبيقات (إعادة تنفيذ اختيارية، مستوحاة من Windows Search)</s:String>
    <s:String x:Key="lang_appsearch_note">هذا ليس بحث النظام ولا بديلاً رسمياً له: فهو يعرض فقط اختصارات قائمة ابدأ. يمكن تعطيله من الخصائص.</s:String>
    <s:String x:Key="lang_appsearch_open">فتح البحث</s:String>
    <s:String x:Key="lang_about_title">حول</s:String>
    <s:String x:Key="lang_about_text">Win7Taskbar مشروع قيد التطوير المستمر يعيد إنشاء شريط مهام Windows 7 فوق شريط المهام الحديث. بعض الأجزاء لم تكتمل بعد، ولا تزال الدقة الكاملة غير مضمونة. بعض الوظائف يعاد بناؤها من الصفر، بينما يتم ربط وظائف أخرى وإعادة تموضعها. القيود المعروفة: لا يدعم تدوير شريط المهام حالياً؛ أما نوافذ النظام مثل اللوحات المنبثقة وقائمة ابدأ فيتم ربطها وإعادة تموضعها، وليس إعادة إنشائها.</s:String>
    <s:String x:Key="lang_credits">حقوق المساهمين: 3ds لبعض الموارد الرسومية وللإلهام بفكرة XAML.</s:String>
</ResourceDictionary>
