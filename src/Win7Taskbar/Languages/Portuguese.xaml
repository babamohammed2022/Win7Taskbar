<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- Português (Brasil) -->
    <s:String x:Key="lang_show_hidden">Mostrar ícones ocultos</s:String>
    <s:String x:Key="lang_start_tip">Iniciar</s:String>
    <s:String x:Key="lang_taskbar">Barra de tarefas</s:String>
    <s:String x:Key="lang_show_seconds">Mostrar segundos no relógio</s:String>
    <s:String x:Key="lang_show_seconds_desc">Quando ativado, o relógio é atualizado a cada segundo; caso contrário, a cada minuto.</s:String>
    <s:String x:Key="lang_clock_flyout">Painel do relógio</s:String>
    <s:String x:Key="lang_clock_flyout_desc">Normalmente é usado o painel real do Windows. Se o sistema não o fornecer, é usado automaticamente o recriado.</s:String>
    <s:String x:Key="lang_clock_label">Relógio:</s:String>
    <s:String x:Key="lang_clock_w7">Tema clássico (recriado)</s:String>
    <s:String x:Key="lang_clock_native">Windows 7</s:String>
    <s:String x:Key="lang_close_desc">Fechar o Win7Taskbar restaurará a barra de tarefas do Windows.</s:String>
    <s:String x:Key="lang_close_button">Fechar o Win7Taskbar</s:String>
    <s:String x:Key="lang_close_confirm">Fechar o Win7Taskbar e restaurar a barra de tarefas do Windows?</s:String>
    <s:String x:Key="lang_properties_title">Propriedades - Win7Taskbar</s:String>
    <s:String x:Key="lang_ok">OK</s:String>
    <s:String x:Key="lang_cancel">Cancelar</s:String>
    <s:String x:Key="lang_language">Idioma:</s:String>
    <s:String x:Key="lang_language_desc">Selecione o idioma da interface.</s:String>
    <s:String x:Key="lang_italian">Italiano</s:String>
    <s:String x:Key="lang_english">English</s:String>
    <s:String x:Key="lang_customize">Personalizar...</s:String>
    <s:String x:Key="lang_show_desktop">Mostrar área de trabalho</s:String>
    <s:String x:Key="lang_peek_desktop">Espiar área de trabalho</s:String>
    <s:String x:Key="lang_edit_datetime">Ajustar data/hora</s:String>
    <s:String x:Key="lang_customize_notify">Personalizar área de notificação...</s:String>
    <s:String x:Key="lang_task_manager">Iniciar Gerenciador de tarefas</s:String>
    <s:String x:Key="lang_properties">Propriedades</s:String>
    <s:String x:Key="lang_minimize_group">Minimizar grupo</s:String>
    <s:String x:Key="lang_close_group">Fechar grupo</s:String>
    <s:String x:Key="lang_appsearch">Pesquisa de aplicativos</s:String>
    <s:String x:Key="lang_appsearch_desc">Pesquisa de aplicativos (reimplementação opcional, inspirada na Pesquisa do Windows)</s:String>
    <s:String x:Key="lang_appsearch_note">Não é a pesquisa do sistema nem um substituto oficial: lista apenas os atalhos do menu Iniciar. Pode ser desativada nas Propriedades.</s:String>
    <s:String x:Key="lang_appsearch_open">Abrir pesquisa</s:String>
    <s:String x:Key="lang_about_title">Sobre</s:String>
    <s:String x:Key="lang_about_text">O Win7Taskbar é um projeto best-effort em constante melhoria que recria a barra de tarefas do Windows 7 sobre a moderna: a precisão melhorará com o tempo. Limitações conhecidas: a rotação da barra de tarefas (lados/topo) não é suportada, então a opção correspondente é atualmente decorativa; as janelas do sistema (painéis, menu Iniciar) são ancoradas e reposicionadas, não recriadas.</s:String>
    <s:String x:Key="lang_credits">Créditos: 3ds por alguns dos recursos gráficos e pela inspiração da ideia XAML.</s:String>
</ResourceDictionary>
