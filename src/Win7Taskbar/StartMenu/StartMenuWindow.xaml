<Window x:Class="Win7Taskbar.StartMenu.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Win7Taskbar.StartMenu"
        Title="Win7Taskbar Start Menu"
        Width="416" Height="548"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="12"
        SourceInitialized="OnSourceInitialized"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewTextInput="OnPreviewTextInput">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Win7 left-pane row: pale cyan hover, 1px glass border. -->
        <Style x:Key="LeftRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0,1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="2,1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Padding" Value="0"/>
                            </DataTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A07BA7CE"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#E8F4FCFF" Offset="0"/>
                                            <GradientStop Color="#C0D4F0FC" Offset="0.5"/>
                                            <GradientStop Color="#A8C4E8F8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B0709CC8"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#D0E8F8FF" Offset="0"/>
                                            <GradientStop Color="#A0C0E4F4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseLeftButtonUp" Handler="OnLeftItemClick"/>
        </Style>

        <!-- Win7 right pane: white text, brighter hover on the glass. -->
        <Style x:Key="RightRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,1,6,1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="3" Padding="8,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Padding" Value="0"/>
                            </DataTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C0FFFFFF"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#90FFFFFF" Offset="0"/>
                                            <GradientStop Color="#50C8E4F8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseLeftButtonUp" Handler="OnRightItemClick"/>
            <EventSetter Event="MouseEnter" Handler="OnRightItemMouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="OnRightItemMouseLeave"/>
        </Style>

        <Style x:Key="PowerMenuItem" TargetType="MenuItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <!-- Outer Aero frame: drawn gradients (no Microsoft bitmaps). -->
    <Border Margin="10,10,10,2" CornerRadius="8,8,0,0" BorderThickness="1"
            BorderBrush="#C06A8BB0">
        <Border.Effect>
            <DropShadowEffect Color="#A0000000" BlurRadius="18" ShadowDepth="0" Opacity="0.65"/>
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#55D0E8F8" Offset="0"/>
                <GradientStop Color="#4088B0C8" Offset="0.45"/>
                <GradientStop Color="#307098B0" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border CornerRadius="7,7,0,0" BorderThickness="1" BorderBrush="#90FFFFFF" Margin="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="242"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Left programs pane -->
                <Border Grid.Column="0" Margin="7,10,5,8" CornerRadius="3"
                        BorderBrush="#90A0B4C8" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#90FFFFFF" Offset="0"/>
                            <GradientStop Color="#70F4F8FC" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="LeftList"
                                 ItemsSource="{Binding LeftItems}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="2,4,2,2"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ItemContainerStyle="{StaticResource LeftRowStyle}"
                                 KeyDown="OnLeftKeyDown"
                                 Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AllProgramsOpen}" Value="True">
                                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="34" Background="Transparent">
                                        <Rectangle Height="1" Fill="#C0C8D4" VerticalAlignment="Center" Margin="8,0">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="32" Height="32"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       VerticalAlignment="Center" Margin="4,0,4,0"
                                                       FontSize="12" Foreground="#1A1A1A"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Path Grid.Column="2" Data="M0,0 L5,4 L0,8 Z" Fill="#3A5068"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  Visibility="{Binding JumpVisibility}"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox x:Name="SearchList"
                                 ItemsSource="{Binding SearchHits}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="2,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ItemContainerStyle="{StaticResource LeftRowStyle}"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="16" Height="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   VerticalAlignment="Center" Margin="4,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="1" Margin="6,2,6,2" Padding="6,4"
                                HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="OnAllProgramsFooter"
                                Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="All Programs" FontWeight="SemiBold"
                                           Visibility="{Binding AllProgramsOpen, Converter={StaticResource InvBoolToVis}}"/>
                                <TextBlock Text="Back" FontWeight="SemiBold"
                                           Visibility="{Binding AllProgramsOpen, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Button>

                        <!-- Search lives under the left pane, as on Windows 7. -->
                        <Border Grid.Row="2" Margin="6,2,6,6" Background="#C0FFFFFF"
                                BorderBrush="#90A0B4C8" BorderThickness="1" CornerRadius="2">
                            <Grid>
                                <TextBlock Text="{Binding SearchHint}" Foreground="#808080"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}"/>
                                <TextBox x:Name="SearchBox"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Padding="6,0"
                                         FontSize="12"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right pane: darker glass, hierarchy, shutdown. -->
                <Border Grid.Column="1" Margin="0,8,8,8" CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#283A5878" Offset="0"/>
                            <GradientStop Color="#18283858" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="8,12,8,8">
                            <Border Width="48" Height="48" CornerRadius="2"
                                    BorderThickness="2"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnUserPictureClick">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F0FFFFFF" Offset="0"/>
                                        <GradientStop Color="#A0C8D8E8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#30405060" Offset="0"/>
                                        <GradientStop Color="#20182838" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Image x:Name="UserPicImage" Source="{Binding UserPicture}"
                                           Stretch="UniformToFill">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HoveredLinkIcon, Converter={StaticResource NullToVis}}" Value="Visible">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Image x:Name="HoverPicImage" Source="{Binding HoveredLinkIcon}"
                                           Stretch="Uniform" Opacity="0">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HoveredLinkIcon, Converter={StaticResource NullToVis}}" Value="Visible">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding UserName}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="White" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.45"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>

                        <ListBox x:Name="RightList" Grid.Row="1"
                                 ItemsSource="{Binding RightLinks}"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="4,4,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource RightRowStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="22">
                                        <Rectangle Height="1" Fill="#60FFFFFF" VerticalAlignment="Center" Margin="4,0">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="White"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,8,4">
                            <Border x:Name="ShutdownChrome" CornerRadius="3,0,0,3"
                                    BorderThickness="1,1,0,1" BorderBrush="#80202838"
                                    Cursor="Hand" MouseLeftButtonUp="OnShutdown">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF6A7A90" Offset="0"/>
                                        <GradientStop Color="#FF3A4860" Offset="0.49"/>
                                        <GradientStop Color="#FF2A3848" Offset="0.5"/>
                                        <GradientStop Color="#FF1A2838" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="ShutdownLabel" Text="Shut down"
                                           Foreground="White" FontSize="12"
                                           Margin="12,4,10,4" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ShutdownArrow" CornerRadius="0,3,3,0"
                                    BorderThickness="1" BorderBrush="#80202838"
                                    Width="22" Cursor="Hand"
                                    MouseLeftButtonUp="OnShutdownArrow">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF6A7A90" Offset="0"/>
                                        <GradientStop Color="#FF3A4860" Offset="0.49"/>
                                        <GradientStop Color="#FF2A3848" Offset="0.5"/>
                                        <GradientStop Color="#FF1A2838" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M0,0 L8,0 L4,5 Z" Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="0,2,0,0"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Popup x:Name="PowerPopup" PlacementTarget="{Binding ElementName=ShutdownArrow}"
                       Placement="Top" StaysOpen="False">
                    <Border Background="#F4F8FCFF" BorderBrush="#A05A7A9C" BorderThickness="1" Padding="2">
                        <Border.Effect>
                            <DropShadowEffect Color="#80000000" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                        </Border.Effect>
                        <StackPanel>
                            <MenuItem Header="Switch user" Click="OnSwitchUser" Style="{StaticResource PowerMenuItem}"/>
                            <MenuItem Header="Log off" Click="OnLogOff" Style="{StaticResource PowerMenuItem}"/>
                            <MenuItem Header="Lock" Click="OnLock" Style="{StaticResource PowerMenuItem}"/>
                            <Separator/>
                            <MenuItem Header="Restart" Click="OnRestart" Style="{StaticResource PowerMenuItem}"/>
                            <MenuItem Header="Sleep" Click="OnSleep" Style="{StaticResource PowerMenuItem}"/>
                            <MenuItem Header="Hibernate" Click="OnHibernate" Style="{StaticResource PowerMenuItem}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Border>
</Window>
