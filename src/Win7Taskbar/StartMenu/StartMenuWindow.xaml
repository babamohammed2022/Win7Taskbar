<Window x:Class="Win7Taskbar.StartMenu.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Win7Taskbar.StartMenu"
        Title="Win7Taskbar Start Menu"
        Width="431" Height="511"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="12"
        SourceInitialized="OnSourceInitialized"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewTextInput="OnPreviewTextInput">
    <!--
      Win7 100% DIP metrics (frame origin = chrome top-left after the
      10/25 shadow inset). Frame 411x476. Photo glass protrudes 25px above.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>

        <SolidColorBrush x:Key="Win7Hairline" Color="#D2E2F1"/>
        <SolidColorBrush x:Key="Win7SearchBand" Color="#F1F6FB"/>

        <Style x:Key="LeftRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Padding" Value="0"/>
                            </DataTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A07BA7CE"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#E8F4FCFF" Offset="0"/>
                                            <GradientStop Color="#C0D4F0FC" Offset="0.5"/>
                                            <GradientStop Color="#A8C4E8F8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B0709CC8"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#D0E8F8FF" Offset="0"/>
                                            <GradientStop Color="#A0C0E4F4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseLeftButtonUp" Handler="OnLeftItemClick"/>
            <EventSetter Event="MouseRightButtonUp" Handler="OnLeftItemContext"/>
        </Style>

        <Style x:Key="RightRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="3" Padding="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Padding" Value="0"/>
                            </DataTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C0FFFFFF"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#90FFFFFF" Offset="0"/>
                                            <GradientStop Color="#50C8E4F8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseLeftButtonUp" Handler="OnRightItemClick"/>
            <EventSetter Event="MouseRightButtonUp" Handler="OnRightItemContext"/>
            <EventSetter Event="MouseEnter" Handler="OnRightItemMouseEnter"/>
        </Style>

        <Style x:Key="AeroScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="17"/>
            <Setter Property="MinWidth" Value="17"/>
            <Setter Property="Background" Value="#FFE8E8E8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#FFE4E4E4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="17"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="17"/>
                            </Grid.RowDefinitions>
                            <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand"
                                          Focusable="False">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="#FFF0F0F0" BorderBrush="#FFA0A0A0" BorderThickness="1">
                                            <Path Data="M0,4 L4,0 L8,4 Z" Fill="#FF404040"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#FFE8E8E8"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd" Margin="1,0" CornerRadius="2"
                                                        BorderBrush="#FF8AA0B8" BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#FFF8FBFF" Offset="0"/>
                                                            <GradientStop Color="#FFD0DCE8" Offset="0.45"/>
                                                            <GradientStop Color="#FFB8C8D8" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="BorderBrush" Value="#FF5A9FD4"/>
                                                        <Setter TargetName="ThumbBd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#FFE8F4FC" Offset="0"/>
                                                                    <GradientStop Color="#FF7EC0F0" Offset="0.5"/>
                                                                    <GradientStop Color="#FF4A9AD8" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#FFE8E8E8"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand"
                                          Focusable="False">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="#FFF0F0F0" BorderBrush="#FFA0A0A0" BorderThickness="1">
                                            <Path Data="M0,0 L8,0 L4,4 Z" Fill="#FF404040"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Frame 411x476. Window pad: 10 left/right/bottom, 25 top (photo). -->
        <Border x:Name="Chrome" Width="411" Height="476"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="10,25,0,0" CornerRadius="8,8,0,0" BorderThickness="1"
                BorderBrush="#C06A8BB0">
            <Border.Effect>
                <DropShadowEffect Color="#A0000000" BlurRadius="18" ShadowDepth="0" Opacity="0.65"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#55D0E8F8" Offset="0"/>
                    <GradientStop Color="#4088B0C8" Offset="0.45"/>
                    <GradientStop Color="#307098B0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border CornerRadius="7,7,0,0" BorderThickness="1" BorderBrush="#90FFFFFF" Margin="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left pane: frame x 9-258, y 9-466 → 250x458. -->
                    <Border Grid.Column="0" Width="250" Height="458"
                            Margin="8,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                            BorderBrush="#90A0B4C8" BorderThickness="1"
                            Background="#FFFFFFFF" CornerRadius="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="381"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="2"/>
                                <RowDefinition Height="43"/>
                            </Grid.RowDefinitions>

                            <ListBox x:Name="LeftList" Grid.Row="0"
                                     ItemsSource="{Binding LeftItems}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0,1,0,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ItemContainerStyle="{StaticResource LeftRowStyle}"
                                     KeyDown="OnLeftKeyDown"
                                     MouseRightButtonUp="OnLeftListContext"
                                     Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource AeroScrollBar}"/>
                                </ListBox.Resources>
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllProgramsOpen}" Value="True">
                                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Height" Value="38"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTreeRow}" Value="True">
                                                            <Setter Property="Height" Value="20"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                            <Setter Property="Height" Value="7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Rectangle Height="1" Fill="{StaticResource Win7Hairline}"
                                                       VerticalAlignment="Center" Margin="11,0">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                            <Grid Margin="{Binding IndentMargin}">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Fill="#3A5068"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Stretch="Uniform" Width="6" Height="8" Margin="2,0,4,0">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Data" Value="M0,0 L6,4 L0,8 Z"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Data" Value="M0,0 L8,0 L4,6 Z"/>
                                                                    <Setter Property="Width" Value="8"/>
                                                                    <Setter Property="Height" Value="6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <Image Grid.Column="1" Source="{Binding Icon}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       Margin="0,0,0,0"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Width" Value="32"/>
                                                            <Setter Property="Height" Value="32"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTreeRow}" Value="True">
                                                                    <Setter Property="Width" Value="16"/>
                                                                    <Setter Property="Height" Value="16"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Grid.Column="2" Text="{Binding Name}"
                                                           VerticalAlignment="Center" Margin="8,0,4,0"
                                                           FontSize="12" Foreground="#1A1A1A"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Path Grid.Column="3" Data="M0,0 L5,4 L0,8 Z" Fill="#3A5068"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Visibility="{Binding JumpVisibility}"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ListBox x:Name="SearchList" Grid.Row="0"
                                     ItemsSource="{Binding SearchHits}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="2,4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ItemContainerStyle="{StaticResource LeftRowStyle}"
                                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource AeroScrollBar}"/>
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="16" Height="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       VerticalAlignment="Center" Margin="4,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- All Programs hairline: frame y=391, x 20-251. -->
                            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource Win7Hairline}"
                                       Margin="11,0,7,0"
                                       Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}"/>

                            <Border x:Name="AllProgramsRow" Grid.Row="2"
                                    Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="3"
                                    Padding="0" Margin="0" Cursor="Hand"
                                    Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}"
                                    MouseLeftButtonUp="OnAllProgramsFooter"
                                    MouseRightButtonUp="OnAllProgramsContext">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#A07BA7CE"/>
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#E8F4FCFF" Offset="0"/>
                                                            <GradientStop Color="#C0D4F0FC" Offset="0.5"/>
                                                            <GradientStop Color="#A8C4E8F8" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- Arrow frame x 19-24 → panel x 10. Text frame x=49 → panel x 40. -->
                                    <Path Data="M0,0 L6,4 L0,8 Z" Fill="#3A5068" Width="6" Height="8"
                                          Stretch="Uniform" Margin="10,0,0,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Visibility="{Binding AllProgramsOpen, Converter={StaticResource InvBoolToVis}}"/>
                                    <Path Data="M6,0 L0,4 L6,8 Z" Fill="#3A5068" Width="6" Height="8"
                                          Stretch="Uniform" Margin="10,0,0,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Visibility="{Binding AllProgramsOpen, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="All Programs" FontSize="12" Foreground="#1A1A1A"
                                               Margin="40,0,0,0" VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Visibility="{Binding AllProgramsOpen, Converter={StaticResource InvBoolToVis}}"/>
                                    <TextBlock Text="Back" FontSize="12" Foreground="#1A1A1A"
                                               Margin="40,0,0,0" VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Visibility="{Binding AllProgramsOpen, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>

                            <!-- Double divider y 422-423. -->
                            <StackPanel Grid.Row="3"
                                        Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}">
                                <Rectangle Height="1" Fill="{StaticResource Win7Hairline}"/>
                                <Rectangle Height="1" Fill="{StaticResource Win7Hairline}"/>
                            </StackPanel>

                            <!-- Search band y 424-466, RGB(241,246,251). Box 222x22. -->
                            <Border Grid.Row="4" Background="{StaticResource Win7SearchBand}">
                                <Grid Width="222" Height="22" Margin="12,10,0,11"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Border BorderBrush="#424246" BorderThickness="1,1,0,0"/>
                                    <Border BorderBrush="#787978" BorderThickness="0,0,1,0"/>
                                    <Border BorderBrush="#ACACAC" BorderThickness="0,0,0,1"/>
                                    <Border Margin="1" Background="#FFFFFF">
                                        <Grid>
                                            <TextBlock Text="{Binding SearchHint}" Foreground="#808080"
                                                       FontStyle="Italic"
                                                       Margin="6,0,22,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}"/>
                                            <TextBox x:Name="SearchBox"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalContentAlignment="Center"
                                                     Padding="6,0,22,0"
                                                     FontSize="12"
                                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                            <!-- Handle points down-RIGHT (Win7). -->
                                            <Canvas Width="16" Height="16" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" Margin="0,0,3,0"
                                                    IsHitTestVisible="False">
                                                <Ellipse Canvas.Left="1" Canvas.Top="1"
                                                         Width="9" Height="9"
                                                         Stroke="#1A73C7" StrokeThickness="1.7"/>
                                                <Path Data="M8.2,8.2 L14.2,14.2"
                                                      Stroke="#1A73C7" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right column from x=259. No inner frosted rectangle. -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="424"/>
                            <RowDefinition Height="43"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="RightList" Grid.Row="0"
                                 ItemsSource="{Binding RightLinks}"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="16,43,8,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource RightRowStyle}"
                                 MouseLeave="OnRightListMouseLeave">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Height" Value="35"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                        <Setter Property="Height" Value="3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Rectangle Height="1" Fill="#60FFFFFF" VerticalAlignment="Center" Margin="0">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="White" FontWeight="Normal">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Shutdown 94x22 at frame x 267-360, y 434-455. -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="8,10,0,0" Height="22">
                            <Border x:Name="ShutdownChrome" Width="72" Height="22"
                                    CornerRadius="3,0,0,3"
                                    BorderThickness="1,1,0,1" BorderBrush="#90FFFFFF"
                                    Cursor="Hand" MouseLeftButtonUp="OnShutdown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#90D0E4F4" Offset="0"/>
                                                    <GradientStop Color="#7088A8C0" Offset="0.49"/>
                                                    <GradientStop Color="#60607090" Offset="0.5"/>
                                                    <GradientStop Color="#50405068" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#B0E8F4FF" Offset="0"/>
                                                            <GradientStop Color="#90A8C8E0" Offset="0.49"/>
                                                            <GradientStop Color="#808090A8" Offset="0.5"/>
                                                            <GradientStop Color="#70607088" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock x:Name="ShutdownLabel" Text="Shut down"
                                           Foreground="White" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ShutdownArrow" Width="22" Height="22"
                                    CornerRadius="0,3,3,0"
                                    BorderThickness="1" BorderBrush="#90FFFFFF"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnShutdownArrow">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#90D0E4F4" Offset="0"/>
                                                    <GradientStop Color="#7088A8C0" Offset="0.49"/>
                                                    <GradientStop Color="#60607090" Offset="0.5"/>
                                                    <GradientStop Color="#50405068" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#B0E8F4FF" Offset="0"/>
                                                            <GradientStop Color="#90A8C8E0" Offset="0.49"/>
                                                            <GradientStop Color="#808090A8" Offset="0.5"/>
                                                            <GradientStop Color="#70607088" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Path Data="M0,0 L8,0 L4,5 Z" Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="0,2,0,0"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Photo glass 55x57 at frame x 309, y -25. Window: 10+309=319, y=0. -->
        <Grid Width="55" Height="57" HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="319,0,0,0" Cursor="Hand" MouseLeftButtonUp="OnUserPictureClick">
            <Border x:Name="PhotoFrame" CornerRadius="2" BorderThickness="2"
                    IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F0FFFFFF" Offset="0"/>
                        <GradientStop Color="#A0C8D8E8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#80FFFFFF" Offset="0"/>
                        <GradientStop Color="#40C8D8E8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="IconOld" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image x:Name="IconNew" Stretch="Uniform" Opacity="0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
