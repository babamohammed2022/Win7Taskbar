  <!--
    v2.58 - what a published, ready-to-run package looks like.
    Kept in the project (not only on the command line) so that `dotnet publish`
    - with or without arguments, from the IDE or from CI - produces the same
    self-contained win-x64 package.
  -->
  <PropertyGroup>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- Single-file publishing is NOT the default, on purpose.
         The application reads Themes/, Resources/ and Languages/ from the
         folder next to the executable (ThemeLoader uses
         AppDomain.CurrentDomain.BaseDirectory) and loads the native core with
         a plain DllImport("Win7TaskbarCore.dll"): keeping them as real files in
         the package is what makes the layout predictable and debuggable. The
         folder-shaped self-contained package is the one published.
         To try the single-file variant: -p:PublishSingleFile=true
         (the WPF native libraries then need IncludeNativeLibrariesForSelfExtract,
         and the content folders must still ship next to the executable).
         The embedded fallback in this project file also covers single-file
         builds for the native core itself: NativeCore restores
         Win7TaskbarCore.dll from the embedded copy (folder of the executable,
         or %LOCALAPPDATA% when it is not writable) and preloads it before the
         first P/Invoke. -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetroBar.Shim\RetroBar.Shim.csproj" />
  </ItemGroup>

  <!-- WPF images are served by GraphicalResourceBundle.cs. Only the eight
       native Aero 9-slice PNGs remain on disk and are copied for the DLL. -->
  <ItemGroup>
    <Content Include="Resources\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Languages\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Languages\*.xaml" />
  </ItemGroup>

  <!--
    Themes/Windows7.xaml NON va compilato in BAML: viene caricato a runtime da
    ThemeLoader, che gli inietta in memoria il riferimento a Base.xaml (i 16
    stili con BasedOn su se stessi non si risolvono in nessun altro modo).
    Resta quindi un file su disco, byte-identico all'originale del repository.
  -->
  <ItemGroup>
    <Page Remove="Themes\Windows7.xaml" />
    <Resource Remove="Themes\Windows7.xaml" />
    <Content Include="Themes\Windows7.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      v1.21.19: Windows 8.1 skin, same treatment as Windows7.xaml - loaded from
      disk at runtime by ThemeLoader (ThemeFileNameFor maps the id to
      "Windows8.1.xaml"), so it must NOT be compiled into BAML: it is Content
      and is copied next to the executable. Its Start button reads the two
      sprites embedded in GraphicalResourceBundle (startwin81flag /
      startwin81flagscaled), so no PNG has to ship for it.
    -->
    <Page Remove="Themes\Windows8.1.xaml" />
    <Resource Remove="Themes\Windows8.1.xaml" />
    <Content Include="Themes\Windows8.1.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Embedded fallback copy of the native core.

    The native core is loaded with plain DllImport("Win7TaskbarCore.dll"),
    so Windows looks for that file next to the executable. A package where
    the file went missing anyway (partial ZIP extraction, executable copied
    alone during an update, launch from inside the ZIP viewer, antivirus
    quarantine) used to stop at startup with a fatal error.

    Since dist/Win7TaskbarCore.dll is versioned in the repository and the
    packaging scripts always build it from the same tree as the executable,
    it can also be EMBEDDED here. At startup NativeCore compares the file
    next to the executable with this embedded copy and, when the file is
    missing, different or unloadable, writes the embedded copy back and
    loads it explicitly. The resource names are read by NativeCore.cs and
    verified by publish.ps1 (the package check looks for the core resource
    name inside the published Win7Taskbar.dll): keep the three places in
    sync. W7TInject.dll is optional (its absence only degrades the frozen
    clock flyout) and is embedded with the same mechanism when present.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\dist\Win7TaskbarCore.dll')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\dist\Win7TaskbarCore.dll">
      <LogicalName>Win7Taskbar.Win7TaskbarCore.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\dist\W7TInject.dll')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\dist\W7TInject.dll">
      <LogicalName>Win7Taskbar.W7TInject.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Copia la DLL nativa accanto all'eseguibile, se e' gia' stata compilata.
    Il target non fallisce se manca: cosi' `dotnet build` funziona anche
    prima di aver eseguito CMake.
  -->
  <Target Name="CopyNativeCore" AfterTargets="Build">
    <ItemGroup>
      <NativeCoreDll Include="$(MSBuildThisFileDirectory)..\..\dist\Win7TaskbarCore.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeCoreDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(NativeCoreDll.FullPath)')" />
    <Warning Text="Win7TaskbarCore.dll non trovata in dist/. Compilare prima il progetto CMake in native/."
             Condition="!Exists('$(MSBuildThisFileDirectory)..\..\dist\Win7TaskbarCore.dll')" />
  </Target>

  <!-- Stessa copia anche per `dotnet publish`, che non passa da $(OutDir). -->
  <Target Name="CopyNativeCoreOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <NativeCoreDllPub Include="$(MSBuildThisFileDirectory)..\..\dist\Win7TaskbarCore.dll" />
      <NativeHelperPub Include="$(MSBuildThisFileDirectory)..\..\dist\Win7StartHelper.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeCoreDllPub)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(NativeCoreDllPub.FullPath)')" />
    <Copy SourceFiles="@(NativeHelperPub)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(NativeHelperPub.FullPath)')" />
    <Error Text="Win7TaskbarCore.dll non trovata in dist/: eseguire prima la build CMake in native/."
           Condition="!Exists('$(MSBuildThisFileDirectory)..\..\dist\Win7TaskbarCore.dll')" />
  </Target>

</Project>
