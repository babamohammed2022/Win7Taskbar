  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Makes the inbox WindowsDesktop System.Drawing reference available
         for CopyFromScreen; no NuGet or third-party dependency is added. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseSystemDrawing>true</UseSystemDrawing>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Win7Taskbar</AssemblyName>
    <RootNamespace>Win7Taskbar</RootNamespace>

    <!-- La DLL nativa e' x64: l'EXE deve esserlo altrettanto, altrimenti
         il P/Invoke fallisce con BadImageFormatException. -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- ================================================================
         v2.58 - SELF-CONTAINED DISTRIBUTION.
         The published package must run on a Windows 10/11 machine that has no
         .NET installed at all, so the app carries its own runtime. The SDK
         decides per publish command (-p:SelfContained=true/false), the default
         below is what a plain publish produces.
         ================================================================ -->
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>8.0.0</RuntimeFrameworkVersion>
    <UseAppHost>true</UseAppHost>

    <!-- Consente di compilare (non eseguire) su Linux/macOS. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Product>Win7Taskbar</Product>
    <Description>Taskbar in stile Windows 7 per Windows 10/11</Description>
    <Copyright>Copyright (c) 2026 Win7Taskbar contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
