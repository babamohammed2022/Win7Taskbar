<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:RetroBar.Controls;assembly=RetroBar"
                    xmlns:conv="clr-namespace:Win7Taskbar.Converters"
                    xmlns:w7util="clr-namespace:Win7Taskbar.Utilities">

    <!-- Posizionamento delle anteprime di finestra.
         Converter portati da RetroBar (Apache 2.0, (c) dremin): senza questi
         il popup si allineerebbe al bordo sinistro del pulsante invece di
         restare centrato su di esso. -->
    <!-- v2.58: larghezza minima dei pulsanti della Superbar. Il tema dichiara
         TaskButtonMinWidth = 50; qui e' il 4% in piu' (52), la stessa crescita
         applicata alla cornice dell'icona, cosi' il pulsante si allarga senza
         che l'icona cambi dimensione. -->
    <system:Double x:Key="TaskButtonMinWidthOverride">52</system:Double>

    <!-- ==================================================================
         v3.7: GLOW AERO DEL PULSANTE (il "luminoso radiale" di Windows 7).

         Quando il puntatore e' sopra un pulsante della barra, Windows 7
         disegnava attorno all'icona un alone radiale morbido (la taskbar
         lo tracciava con DrawRadialGradient, TASKBAND_RADIALGRADIENT):
         luce bianco-blu piu' intensa verso il basso, che sfuma fino a
         diventare trasparente ai bordi. Qui e' lo stesso effetto con un
         RadialGradientBrush nativo di WPF, nessun hook in Explorer.

         - Coordinate proporzionali (0..1): il gradiale scala con la
           larghezza/altezza del pulsante, quindi e' corretto a 100/125/
           150% di scala e a qualsiasi altezza della barra.
         - La palette riprende il #D6F0FF gia' usato dal tema per il glow
           inferiore dei pulsanti (TaskButtonBottomBackgroundHover),
           esteso in un alone completo centrato un po' sotto il mezzo,
           come la luce che in Windows 7 partiva dal bordo inferiore.
         - Opacita' gestita dalle animazioni dei template Superbar*
           (dissolvenza in ingresso 0.18 s, in uscita 0.35 s, HoldEnd),
           lo stesso pattern gia' usato dall'orb del menu Start nel tema.
         ================================================================== -->
    <RadialGradientBrush x:Key="SuperbarAeroGlowBrush"
                         GradientOrigin="0.5,0.62"
                         Center="0.5,0.62"
                         RadiusX="0.78"
                         RadiusY="0.66">
        <GradientStop Color="#A8FFFFFF" Offset="0.0" />
        <GradientStop Color="#66E4F1FF" Offset="0.3" />
        <GradientStop Color="#2AD6F0FF" Offset="0.62" />
        <GradientStop Color="#00D6F0FF" Offset="1.0" />
    </RadialGradientBrush>

    <conv:ToolTipHorizontalOffsetConverter x:Key="ToolTipHorizontalOffset" />
    <conv:ToolTipVerticalOffsetConverter x:Key="ToolTipVerticalOffset" />
    <conv:ToolTipPlacementConverter x:Key="ToolTipPlacement" />

    <!-- v2.46: quante "schede" impilate disegnare accanto all'icona.
         Il parametro e' la posizione della scheda (1, 2, 3): il converter
         risponde Visible finche' il gruppo ha almeno tante finestre quante
         ne indica la posizione, e non disegna nulla con una sola finestra. -->
    <conv:WindowStackVisibilityConverter x:Key="WindowStackVisibility" />
    <conv:WindowStackOuterBorderOffsetConverter x:Key="WindowStackOuterBorderOffset" />

    <!-- v2.61: sposta di una percentuale della larghezza del pulsante (5%)
         le linee dell'indicatore "finestre impilate". Proporzionale alla
         larghezza reale, quindi identico a 100%, 125% e 150% e con pulsanti
         larghi o stretti: si ricalcola da ActualWidth. -->
    <conv:WidthRatioConverter x:Key="WidthRatio" />

    <!-- Startup fallback only. TaskbarWindow replaces this application-level
         DynamicResource with the current DWM colorization brush and again on
         WM_DWMCOLORIZATIONCOLORCHANGED. -->
    <SolidColorBrush x:Key="DwmPreviewAccentBrush" Color="#FF4C8FC5" />

    <!-- Exact slicing of the user-supplied DWMBorder.png. Its transparent
         aperture is x=17..218, y=38..146 (202x109) in the 236x166 bitmap.
         Corners remain pixel-sized; only straight edge sections stretch, so
         the frame adapts to each aspect-correct live DWM thumbnail without
         distorting rounded corners or leaving uncovered inner gaps.

         Per Microsoft WPF opacity-mask semantics, only the PNG alpha channel
         controls visibility; its grayscale RGB/luminance is intentionally
         ignored. The underlying Fill is the dynamic system accent brush. -->
    <ControlTemplate x:Key="TaskPreviewFrameVista"
                     TargetType="ContentControl">
        <Grid SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="19" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="17" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="17" />
            </Grid.ColumnDefinitions>

            <!-- Accent layer, two interchangeable sources. Either the eight
                 masked rectangles below (the XAML path, which is also the
                 fallback) or the single NativeAeroFrameRect that follows,
                 painted with the frame the core's native 9-slice renderer
                 hands over. TaskbarWindow shows that rectangle and collapses
                 this grid when the core can supply the frame, and does the
                 opposite as soon as it cannot, so the template is complete
                 and correct on its own. The wrapper repeats the outer 3x3
                 definitions to keep every slice exactly where it is: 17px
                 sides, 38px top chrome, 19px bottom. -->
            <Grid x:Name="AccentSliceLayer"
                  Grid.Row="0" Grid.RowSpan="3"
                  Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="19" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="17" />
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Row="0" Grid.Column="0"
                           Fill="{DynamicResource DwmPreviewAccentBrush}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderMaskImage}"
                                    Viewbox="0,0,17,38"
                                    ViewboxUnits="Absolute"
                                    Stretch="Fill" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Grid.Row="0" Grid.Column="1"
                           Fill="{DynamicResource DwmPreviewAccentBrush}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderMaskImage}"
                                    Viewbox="17,0,202,38"
                                    ViewboxUnits="Absolute"
                                    Stretch="Fill" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Grid.Row="0" Grid.Column="2"
                           Fill="{DynamicResource DwmPreviewAccentBrush}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderMaskImage}"
                                    Viewbox="219,0,17,38"
                                    ViewboxUnits="Absolute"
                                    Stretch="Fill" />
                    </Rectangle.OpacityMask>
                </Rectangle>

                <Rectangle Grid.Row="1" Grid.Column="0"
                           Fill="{DynamicResource DwmPreviewAccentBrush}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderMaskImage}"
                                    Viewbox="0,38,17,109"
                                    ViewboxUnits="Absolute"
                                    Stretch="Fill" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Grid.Row="1" Grid.Column="2"
                           Fill="{DynamicResource DwmPreviewAccentBrush}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderMaskImage}"
                                    Viewbox="219,38,17,109"
                                    ViewboxUnits="Absolute"
                                    Stretch="Fill" />
                    </Rectangle.OpacityMask>
                </Rectangle>

                <Rectangle Grid.Row="2" Grid.Column="0"
                           Fill="{DynamicResource DwmPreviewAccentBrush}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderMaskImage}"
                                    Viewbox="0,147,17,19"
                                    ViewboxUnits="Absolute"
                                    Stretch="Fill" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Grid.Row="2" Grid.Column="1"
                           Fill="{DynamicResource DwmPreviewAccentBrush}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderMaskImage}"
                                    Viewbox="17,147,202,19"
                                    ViewboxUnits="Absolute"
                                    Stretch="Fill" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Grid.Row="2" Grid.Column="2"
                           Fill="{DynamicResource DwmPreviewAccentBrush}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderMaskImage}"
                                    Viewbox="219,147,17,19"
                                    ViewboxUnits="Absolute"
                                    Stretch="Fill" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>

            <!-- The same frame drawn by the core (Utilities/NativePreviewFrame
                 -> W7T_RenderAeroThumbnailFrame): premultiplied BGRA rendered
                 at this element's exact device size and DPI, so the brush maps
                 it 1:1 and the corners are never resampled. Its centre cell is
                 fully transparent, exactly like the aperture the eight
                 rectangles leave empty, and the grayscale overlay below stays
                 on top of it either way: shading and clipped static blur are
                 untouched.

                 A Shape, not an Image, on purpose. An Image reports its source
                 as desired size, and a desired size spanning the star row and
                 the star column of this grid would feed back into the frame's
                 own measure: a thumbnail that refits smaller (TaskThumbnail
                 resizes itself after the DWM source-size probe) could then
                 find a frame that refuses to shrink. A Rectangle with a brush
                 contributes nothing to the measure, so the frame keeps being
                 sized only by the ContentPresenter, as it is today. -->
            <Rectangle x:Name="NativeAeroFrameRect"
                       Grid.Row="0" Grid.RowSpan="3"
                       Grid.Column="0" Grid.ColumnSpan="3"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />

            <!-- Preserve the exact photographic shading and edge detail of
                 the supplied border above the accent layer. A restrained
                 grayscale overlay keeps the live accent visible and lets the
                 clipped static blur show through; the PNG remains unchanged. -->
            <Rectangle Grid.Row="0" Grid.Column="0" Opacity="0.18">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderImage}"
                                Viewbox="0,0,17,38"
                                ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Opacity="0.18">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderImage}"
                                Viewbox="17,0,202,38"
                                ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Opacity="0.18">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderImage}"
                                Viewbox="219,0,17,38"
                                ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Opacity="0.18">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderImage}"
                                Viewbox="0,38,17,109"
                                ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Opacity="0.18">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderImage}"
                                Viewbox="219,38,17,109"
                                ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Opacity="0.18">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderImage}"
                                Viewbox="0,147,17,19"
                                ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Opacity="0.18">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderImage}"
                                Viewbox="17,147,202,19"
                                ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Opacity="0.18">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{DynamicResource DwmPreviewBorderImage}"
                                Viewbox="219,147,17,19"
                                ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>

            <!-- v3.9: DWM occupa sempre l'intera apertura fissa 202x109.
                 Il ContentPresenter riempie sempre l'area "*" disponibile
                 (Stretch), cosi' la superficie live copre tutta la finestra
                 del riquadro invece di ridimensionare il frame esterno. -->
            <ContentPresenter Grid.Row="1" Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />
        </Grid>
    </ControlTemplate>

    <!-- ==================================================================
         v2.51: PULSANTE DI CHIUSURA DELL'ANTEPRIMA.

         Tre stati 14x14 ritagliati da close_button.png (ViGlance,
         lee-soft/ViGlance, GPL-3.0): normale, passaggio del mouse, premuto.
         E' la X rossastra della Superbar, col suo glifo bianco dentro.

         Il pulsante vive DENTRO il bordo della cornice (margine 3), cioe'
         FUORI dal rettangolo della miniatura DWM: li' il compositore non
         disegna niente sopra di noi, quindi la X si vede sempre.
         ================================================================== -->
    <Style x:Key="TaskPreviewCloseButton" TargetType="Button">
        <!-- 20x20 hit target; the artwork remains exactly 14x14 and is
             centred, extending the clickable area 3px on every side. -->
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Image x:Name="CloseGlyph"
                           Source="{x:Static w7util:PreviewAssets.PreviewCloseNormal}"
                           Width="14" Height="14" Stretch="None"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CloseGlyph" Property="Source"
                                    Value="{x:Static w7util:PreviewAssets.PreviewCloseHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CloseGlyph" Property="Source"
                                    Value="{x:Static w7util:PreviewAssets.PreviewClosePressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         Testo dei bottoni della Superbar.
         Il TaskButton del tema espone un ContentPresenter: qui definiamo
         cosa ci finisce dentro (icona + titolo + contatore di gruppo).
         ================================================================== -->
    <DataTemplate x:Key="TaskButtonContentTemplate">
        <!-- v1.7.1: the template root is a Grid so the window-count
             separators are a RIGHT-ALIGNED OVERLAY that takes no layout
             space: the icon keeps exactly the size and position it has
             with a single open window (the previous 12px column pushed
             the icon off-centre). The lines are the native soft-edged
             strip the user shipped at Resources/multiplewindowborder.png
             (3x43, feathered alpha): no more hard 1px black rects.
             Rules (Superbar): 2 windows -> 1 line, 3+ windows -> 2 lines,
             the second one a small step further left. The overlay never
             hittests, so clicks go through to the button. -->
        <Grid>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch">
                <!-- v2.54: icona a 32 px (la v2.53 l'aveva portata a 36 e
                     l'effetto era "icone ciccione": la richiesta era di
                     allargare la CORNICE, non l'icona). -->
                <Image Source="{Binding Icon}"
                       Width="32"
                       Height="32"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" />
            </StackPanel>
            <Grid IsHitTestVisible="False">
                <!-- linea piu' vicina al bordo destro (2 finestre) -->
                <!-- v2.63: the OUTER line sits at a FIXED +11.3% of the
                     button width at every count (the v1.7.2 per-sheet
                     slide and the v1.7.6 count>2 branches are retired).
                     The strip is 3x43 with feathered alpha: its rendered
                     colour is the composite at its position, so a border
                     that slid right as sheets opened changed colour with
                     the window count. Frozen at the 3+ placement, a
                     2-window group's border is pixel-identical to a 3+
                     group's outer border - the same colour by
                     construction. RenderTransform has zero layout
                     impact, like the rest of the overlay. -->
                <Image Source="{DynamicResource Win7_WindowStackBorderImage}"
                       Width="3" Height="40"
                       Stretch="Fill"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,1,0"
                       SnapsToDevicePixels="True"
                       Visibility="{Binding WindowCount,
                                    Converter={StaticResource WindowStackVisibility},
                                    ConverterParameter=1}">
                    <Image.RenderTransform>
                        <TranslateTransform>
                            <TranslateTransform.X>
                                <MultiBinding Converter="{StaticResource WindowStackOuterBorderOffset}">
                                    <Binding RelativeSource="{RelativeSource AncestorType=Button}"
                                             Path="ActualWidth" />
                                    <Binding Path="WindowCount" />
                                </MultiBinding>
                            </TranslateTransform.X>
                        </TranslateTransform>
                    </Image.RenderTransform>
                </Image>
                <!-- seconda linea, un gradino piu' a sinistra (3+ finestre) -->
                <!-- v2.63: fixed +10.3% (parameter "inner"), 1% of the
                     button width left of the outer line, at every count -
                     never moves, so it never changes colour either.
                     RenderTransform again: zero layout impact. -->
                <Image Source="{DynamicResource Win7_WindowStackBorderImage}"
                       Width="3" Height="40"
                       Stretch="Fill"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       SnapsToDevicePixels="True"
                       Visibility="{Binding WindowCount,
                                    Converter={StaticResource WindowStackVisibility},
                                    ConverterParameter=2}">
                    <Image.RenderTransform>
                        <TranslateTransform>
                            <TranslateTransform.X>
                                <MultiBinding Converter="{StaticResource WindowStackOuterBorderOffset}"
                                              ConverterParameter="inner">
                                    <Binding RelativeSource="{RelativeSource AncestorType=Button}"
                                             Path="ActualWidth" />
                                    <Binding Path="WindowCount" />
                                </MultiBinding>
                            </TranslateTransform.X>
                        </TranslateTransform>
                    </Image.RenderTransform>
                </Image>
            </Grid>
            <!-- v2.62: the small up-arrow trigger of v2.61 was removed on
                 request - the Jump List opens with the Windows 7 drag (left
                 press + drag away from the bar); the trigger code in
                 TaskbarWindow.JumpList.cs simply finds no arrow element
                 anymore and stays inert. -->
        </Grid>
    </DataTemplate>

    <!-- ==================================================================
         Voce del picker delle finestre (click sinistro su un gruppo).
         ================================================================== -->
    <DataTemplate x:Key="WindowPickerItemTemplate">
        <StackPanel Orientation="Horizontal"
                    Margin="2"
                    VerticalAlignment="Center">
            <Image Source="{Binding Icon}"
                   Width="16"
                   Height="16"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0" />
            <TextBlock Text="{Binding Title}"
                       VerticalAlignment="Center"
                       MaxWidth="260"
                       TextTrimming="CharacterEllipsis"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       FontSize="{DynamicResource GlobalFontSize}" />
        </StackPanel>
    </DataTemplate>

    <!-- ==================================================================
         Tooltip di anteprima testuale del titolo (hover sul bottone).
         ================================================================== -->
    <Style x:Key="TaskButtonToolTip" TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}" />
    </Style>


    <!-- ==================================================================
         v2.20: stile del bottone Superbar con STATI reali.
         Idle  = TaskButton normale (pinnata non avviata);
         Running/Active = template "active" del tema Windows 7 (bordo
         alto fino al margine della barra + glow inferiore), applicato
         con un DataTrigger su TaskGroup.IsActive. Il template e' copiato
         qui da Windows7.xaml (che resta byte-identico all'originale).
         ================================================================== -->
    <!-- v2.29: IDLE pinnati: stessa geometria dei bottoni aperti (doppio
         bordo 2px) ma la tessera di hover e' LEGGERMENTE PIU' LARGA del
         bottone (3px per lato, Margin negativo su un layer dedicato che
         non partecipa al layout): come le tessere hover della tray, che
         debordano sull'icona. Texture = TrayTileHoverImage. -->
        <!-- ==================================================================
         v2.52: SFONDO DEI PULSANTI DELLE APPLICAZIONI.

         Le due immagini fornite dall'utente (60x40, con trasparenza) si
         usano a TRE PEZZI: bordo sinistro 6 px e bordo destro 6 px restano
         alla loro misura (portano gli angoli arrotondati e il bordo scuro),
         la parte centrale si stira in orizzontale per coprire la larghezza
         del pulsante. In verticale non c'e' nulla da stirare: le immagini
         sono alte come la barra.

         Hover  (image-1, blu pieno)   -> pulsanti in esecuzione + hover
         Active (image-2, azzurro)     -> finestra in primo piano

         NON riguardano il pulsante Start ne' le icone dell'area di
         notifica: quelli hanno i loro sfondi e i loro template.
         ================================================================== -->
    <ControlTemplate x:Key="TaskButtonFrameHover" TargetType="ContentControl">
        <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{x:Static w7util:TaskButtonAssets.Hover}"
                                Viewbox="0,0,6,40" ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.Column="1" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{x:Static w7util:TaskButtonAssets.Hover}"
                                Viewbox="6,0,48,40" ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.Column="2" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{x:Static w7util:TaskButtonAssets.Hover}"
                                Viewbox="54,0,6,40" ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="TaskButtonFrameActive" TargetType="ContentControl">
        <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{x:Static w7util:TaskButtonAssets.Active}"
                                Viewbox="0,0,6,40" ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.Column="1" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{x:Static w7util:TaskButtonAssets.Active}"
                                Viewbox="6,0,48,40" ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.Column="2" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{x:Static w7util:TaskButtonAssets.Active}"
                                Viewbox="54,0,6,40" ViewboxUnits="Absolute"
                                Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- User-supplied orange notification tile. Three-slice rendering keeps
         its rounded side borders at native width while only the centre grows. -->
    <ControlTemplate x:Key="TaskButtonFrameNotification"
                     TargetType="ContentControl">
        <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{x:Static w7util:TaskButtonAssets.Notification}"
