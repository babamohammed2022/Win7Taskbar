    <!-- ==================================================================
         v1.21.50 - STATO DI HOVER DELLA SYSTEM TRAY: TESSERA SPOSTATA A
         SINISTRA E RIDOTTA.

         Il template implicito del controllo NotifyIcon (quello che accende
         la tessera di vetro TrayTileHoverImage sopra l'icona della tray
         al passaggio del mouse) viene RIDICHIARATO QUI, in Overrides.xaml,
         con la nuova geometria richiesta: i file dei temi Windows7.xaml e
         Windows8.1.xaml restano BYTE-IDENTICI (vincolo della richiesta e
         politica del repository: il tema su disco non si tocca). Il
         meccanismo e' lo stesso gia' usato dagli altri pezzi copiati in
         questo dizionario (SuperbarIdleTemplate in v2.20): Overrides.xaml
         e' compilato nell'assembly e mergiato DOPO il tema da
         ThemeLoader.Build(), e fra dizionari mergiati vince l'ultimo
         aggiunto, quindi questo stile implicito sostituisce quello omonimo
         del tema attivo (Windows 7, Windows 8.1 e di conseguenza anche la
         skin Aero Basic, che e' il tema Windows 7 con i pennelli di
         AeroBasic.xaml sopra).

         GEOMETRIA (v1.21.50, richiesta esplicita dell'utente)
         ====================================================
         Partendo dalle misure della v1.21.49 (28.6944 x 38.2592, derivate
         dalla 1.21.46 29.4 x 39.2 con la riduzione del 2.4%):
           * la tessera e' RIDOTTA del 2.2% (moltiplicatore 0.978):
             28.6944 x 38.2592 -> 28.0631232 x 37.4174976 (l'abbreviazione
             verticale 26.352 -> 25.772256 segue la stessa scala, come
             avevano fatto la 1.21.48 e la 1.21.49);
           * la tessera e' SPOSTATA del 2.5% della propria larghezza PIU'
             A SINISTRA rispetto alla posizione centrata sull'icona:
             l'offset orizzontale da -larghezza/2 (-14.0315616) diventa
             -larghezza/2 - 2.5% della larghezza (-14.0315616 - 0.70157808
             = -14.73313968).

         Il resto del template e' una COPIA fedele di quello del tema
         (Windows7.xaml): Canvas a misura zero centrato sull'icona che non
         partecipa al layout, dissolvenze 0.12 s / 0.25 s, spillo del
         pin/unpin, griglia con sfondo trasparente per l'hit-test dell'intera
         cella (v1.21.11). Il nome HoverTileImg e' TUTTO tranne opzionale:
         gli storyboard lo cercano per nome (lezione della v1.21.24).
         Le tessere di hover del pannello di overflow (nativo e ripiego
         XAML) restano quelle della v1.21.49: la richiesta riguarda la
         system tray sulla barra.
         ================================================================== -->
    <Style TargetType="{x:Type controls:NotifyIcon}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NotifyIcon}">
                    <!-- v1.21.11: Background=Transparent sulla Grid radice:
                         l'intera cella dell'icona resta hit-test viva
                         (mouse-down e trascinamento anche nel margine). -->
                    <Grid SnapsToDevicePixels="True"
                          Background="Transparent">
                        <!-- Tessera di hover: Canvas 0x0 centrato sul glifo,
                             la PNG non partecipa al layout. v1.21.50:
                             -2.2% di misura e -2.5% di larghezza piu' a
                             sinistra (vedere il commento dello stile). -->
                        <Canvas x:Name="HoverCanvas"
                                Width="0"
                                Height="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Image x:Name="HoverTileImg"
                                   Width="28.0631232"
                                   Height="37.4174976"
                                   Canvas.Left="-14.73313968"
                                   Canvas.Top="-18.7087488"
                                   Stretch="Fill"
                                   SnapsToDevicePixels="True"
                                   Source="{DynamicResource TrayTileHoverImage}"
                                   Opacity="0" />
                        </Canvas>
                        <ContentPresenter x:Name="Content" />
                        <!-- Spillo pin/unpin al passaggio del mouse: scrive
                             NotifyIcon.IsPinned (API pubblica ManagedShell)
                             e sposta subito l'icona fra tray e overflow. -->
                        <ToggleButton x:Name="PinToggle"
                                      Width="9"
                                      Height="9"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,1,1,0"
                                      Opacity="0"
                                      ToolTip="Sposta fra tray e overflow (pin/unpin)"
                                      Visibility="Collapsed"
                                      IsChecked="{Binding IsPinned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Focusable"
                                            Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="PinBg"
                                                        Background="Transparent"
                                                        CornerRadius="2"
                                                        Padding="1">
                                                    <Path Data="M1.5,0.5 h5 v3.5 l-1,1 v2.5 l-1.5,1.5 -1.5,-1.5 v-2.5 l-1,-1 z"
                                                          Stretch="Uniform">
                                                        <Path.Fill>
                                                            <SolidColorBrush Color="#FF4A4A4A" />
                                                        </Path.Fill>
                                                        <Path.LayoutTransform>
                                                            <ScaleTransform ScaleX="-1" />
                                                        </Path.LayoutTransform>
                                                    </Path>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="PinBg"
                                                                Property="Background"
                                                                Value="#406EA5D2" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed"
                                                             Value="True">
                                                        <Setter TargetName="PinBg"
                                                                Property="Background"
                                                                Value="#736EA5D2" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked"
                                                             Value="True">
                                                        <Setter TargetName="PinBg"
                                                                Property="Background"
                                                                Value="#66000000" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BarsIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverTileImg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PinToggle"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.9"
                                                         Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="BarsOut">
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop"
                                                         Storyboard.TargetName="HoverTileImg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.25" />
                                        <DoubleAnimation FillBehavior="Stop"
                                                         Storyboard.TargetName="PinToggle"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- barra verticale: tessera abbreviata (26.352 nella
                             v1.21.49) scalata dello stesso -2.2% della
                             v1.21.50 e ricentrata col solito margine +13
                             del Canvas. Solo proprieta' semplici nei Setter:
                             il loader XAML di RetroBar rifiuta le proprieta'
                             attaccate nei Setter. -->
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <Setter TargetName="HoverCanvas"
                                    Property="Margin"
                                    Value="0,13,0,0" />
                            <Setter TargetName="HoverTileImg"
                                    Property="Height"
                                    Value="25.772256" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
