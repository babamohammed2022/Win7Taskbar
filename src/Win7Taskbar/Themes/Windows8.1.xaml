                Value="0,-2,0,0" />
    </Style>

    <Style TargetType="TextBlock"
           x:Key="Clock"
           BasedOn="{StaticResource Clock}">
        <Setter Property="Margin"
                Value="6,1,10,2" />
        <Setter Property="TextAlignment"
                Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <DataTrigger.Setters>
                    <Setter Property="Margin"
                            Value="0,3" />
                </DataTrigger.Setters>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate TargetType="{x:Type UserControl}"
                     x:Key="ClockTemplateKey">
        <!-- v2.28: geometrie orologio dalla mod Windhawk
             "Windows 7 Clock Spacing" (aubymori), applicate come semplici
             parametri geometrici (nessun hook): larghezza 70, margini
             4/2 fra icone e orologio, testo 1px piu' in basso. Le unita'
             WPF sono gia' scalate per DPI come i MulDiv(x,dpi,96) della
             mod. -->
        <Grid HorizontalAlignment="Center"
              MinWidth="70"
              SnapsToDevicePixels="True">
            <!-- real Win7 clock hover (55x29 PNG): side whiskers,
                 invisible at rest -->
            <Image x:Name="ClockHoverImg"
                   Width="72"
                   Height="30"
                   Stretch="Fill"
                   SnapsToDevicePixels="True"
                   Source="{DynamicResource ClockTileHoverImage}"
                   Opacity="0" />
        <StackPanel Orientation="Vertical" Margin="4,1,2,0">
            <TextBlock Text="{Binding Path=Now, StringFormat=t, Mode=OneWay}"
                       Style="{DynamicResource Clock}"
                       Name="ClockText">
            </TextBlock>
            <TextBlock Text="{Binding Path=Now, StringFormat=dddd, Mode=OneWay}"
                       Style="{DynamicResource Clock}"
                       Name="ClockVerticalDayOfWeek"
                       Visibility="Visible"
                       Margin="0,2,0,0">
            </TextBlock>
            <TextBlock Text="{Binding Path=Now, StringFormat=d, Mode=OneWay}"
                       Style="{DynamicResource Clock}"
                       Name="ClockVerticalDate"
                       Visibility="Visible"
                       Margin="0,2,0,0">
            </TextBlock>
        </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <!-- clock hover: the SAME two vertical bars used by the tray
                 icons (battery/network/connection), with the same fade -->
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="ClockBarsIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ClockHoverImg"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="ClockBarsOut">
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop"
                                             Storyboard.TargetName="ClockHoverImg"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Horizontal"/>
                    <Condition Binding="{Binding Path=Rows, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                               Value="1"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                    <Setter TargetName="ClockVerticalDayOfWeek"
                            Property="Visibility"
                            Value="Collapsed" />
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="Image"
           x:Key="ShowDesktopIcon"
           BasedOn="{StaticResource TaskIcon}">
        <Setter Property="Visibility"
                Value="Collapsed" />
    </Style>

    <Style TargetType="Image"
           x:Key="NotifyIcon"
           BasedOn="{StaticResource NotifyIcon}">
        <!-- Win7 tray from the photo: ~24px pitch at 100%, widened by 5%
             (right margin 9). The hover PNG doesn't take part in layout
             (zero-width Canvas), so the item stays as wide as the plain
             16px icon alone. The 4/1 vertical margins keep the icon in
             the same vertical position as the approved version. -->
        <Setter Property="Margin"
                Value="0,4,9,1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <DataTrigger.Setters>
                    <Setter Property="Margin"
                            Value="1,1,2,1" />
                </DataTrigger.Setters>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Win7-style tray hover chrome: hover = authentic Win7 PNG, two side
         whiskers | icon |; at rest the icons remain completely normal.
         The NotifyIcon control is re-templated without touching the
         content (the icon stays the app's plain Image). -->
    <Style TargetType="{x:Type controls:NotifyIcon}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NotifyIcon}">
                    <Grid SnapsToDevicePixels="True">
                        <!-- real Win7 hover: the | | side "whiskers" from the PNG,
                             as tall as the bar (40px) and GEOMETRICALLY centered
                             on each icon's center: the 0x0 Canvas is centered
                             on the icon and the PNG is centered on the Canvas
                             (Canvas.Top = -height/2), with no magic positioning
                             numbers. The Canvas does NOT take part in layout:
                             the item stays 16px wide (tight pitch) and the icon
                             stays in its own position. -->
                        <Canvas x:Name="HoverCanvas"
                                Width="0"
                                Height="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <!-- Exactly 2% narrower/shorter than the original tray-hover tile (98%),
                                 times the 2,5% asked for in the v1.21.24 test round (0,975) = 95,55%:
                                 30 x 40 -> 28,665 x 38,22, still centred on exactly the same icon
                                 geometry (half the size as the offset, as before). Do not compound this
                                 scale on later visual adjustments.
                                 v1.21.24 replaced the <Image> tag with this comment and lost
                                 x:Name="HoverTileImg" (startup crash in Setter.EndInit);
                                 tools/verify-theme-xaml.py now fails the build if that happens again. -->
                            <Image x:Name="HoverTileImg"
                                   Width="28.665"
                                   Height="38.22"
                                   Canvas.Left="-14.3325"
                                   Canvas.Top="-19.11"
                                   Stretch="Fill"
                                   SnapsToDevicePixels="True"
                                   Source="{DynamicResource TrayTileHoverImage}"
                                   Opacity="0" />
                        </Canvas>
                        <!-- template kept clean as in the reference: spacing
                             comes from the NotifyIcon/Tray styles (right
                             margin per icon + group padding) -->
                        <ContentPresenter x:Name="Content" />
                        <!-- REAL tray<->overflow movement in pure XAML:
                             a small pin overlay appears on icon hover.
                             The checkbox writes NotifyIcon.IsPinned (an
                             already-existing public ManagedShell API) ->
                             calls the official Pin()/Unpin() -> the icon
                             moves to the other zone immediately. -->
                        <ToggleButton x:Name="PinToggle"
                                      Width="9"
                                      Height="9"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,1,1,0"
                                      Opacity="0"
                                      ToolTip="Sposta fra tray e overflow (pin/unpin)"
                                      Visibility="Collapsed"
                                      IsChecked="{Binding IsPinned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Focusable"
                                                    Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="PinBg"
                                                                Background="Transparent"
                                                                CornerRadius="2"
                                                                Padding="1">
                                                            <Path Data="M1.5,0.5 h5 v3.5 l-1,1 v2.5 l-1.5,1.5 -1.5,-1.5 v-2.5 l-1,-1 z"
                                                                  Stretch="Uniform">
                                                                <Path.Fill>
                                                                    <SolidColorBrush Color="#FF4A4A4A" />
                                                                </Path.Fill>
                                                                <Path.LayoutTransform>
                                                                    <ScaleTransform ScaleX="-1" />
                                                                </Path.LayoutTransform>
                                                            </Path>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Setter TargetName="PinBg"
                                                                        Property="Background"
                                                                        Value="#406EA5D2" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed"
                                                                     Value="True">
                                                                <Setter TargetName="PinBg"
                                                                        Property="Background"
                                                                        Value="#736EA5D2" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked"
                                                                     Value="True">
                                                                <Setter TargetName="PinBg"
                                                                        Property="Background"
                                                                        Value="#66000000" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BarsIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverTileImg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PinToggle"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.9"
                                                         Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="BarsOut">
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop"
                                                         Storyboard.TargetName="HoverTileImg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.25" />
                                        <DoubleAnimation FillBehavior="Stop"
                                                         Storyboard.TargetName="PinToggle"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- vertical: short hover (27px) centered on the icon;
                             with Canvas.Top fixed at -20 the 27px box needs
                             re-centering by shifting the Canvas by +6.5 (13/2
                             margin). Only plain properties in the Setters: the
                             RetroBar XAML loader rejects attached properties
                             in Setters. -->
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <Setter TargetName="HoverCanvas"
                                    Property="Margin"
                                    Value="0,13,0,0" />
                            <Setter TargetName="HoverTileImg"
                                    Property="Height"
                                    Value="27" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Simulated Win7 notification-area overflow (XAML-only proof of
         concept): adds the up/down chevron after the tray icons; clicking it
         toggles an Aero popup (StaysOpen=True -> stays open while clicking
         icons inside, like ExplorerPatcher/desktop; the chevron closes it)
         listing the icons hidden while RetroBar's collapse option is enabled.
         ItemsSource reuses the app's own NotificationArea.UnpinnedIcons view,
         so no C# logic is touched: the chevron shows only when collapse is on
         AND at least one icon would be hidden. -->
    <Style TargetType="{x:Type controls:NotifyIconList}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NotifyIconList}">
                    <Grid>
                        <DockPanel>
                            <ToggleButton x:Name="OverflowToggle"
                                          DockPanel.Dock="Left"
                                          Style="{DynamicResource TrayOverflowButton}"
                                          IsChecked="{Binding ElementName=OverflowPopup, Path=IsOpen, Mode=TwoWay}"
                                          Visibility="{Binding Source={x:Static retrosettings:Settings.Instance}, Path=CollapseNotifyIcons, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibility}}" />
                            <ContentPresenter />
                        </DockPanel>
                        <Popup x:Name="OverflowPopup"
                               Placement="Top"
                               PlacementTarget="{Binding ElementName=OverflowToggle}"
                               HorizontalOffset="-46"
                               VerticalOffset="-9"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border BorderBrush="#FF868686"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0"
                                                         EndPoint="0,1">
                                        <GradientStop Color="#F3FFFFFF"
                                                      Offset="0.0" />
                                        <GradientStop Color="#EDF4F4F4"
                                                      Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- Win7-style inner white hairline -->
                                <Border BorderBrush="#FFFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <Border.Resources>
                                        <!-- Popup icons: Win7 blue selection (like the
                                             real Windows 7 overflow panel) -->
                                        <Style x:Key="PopupNotifyIcon"
                                               TargetType="{x:Type controls:NotifyIcon}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type controls:NotifyIcon}">
                                                        <Grid SnapsToDevicePixels="True">
                                                        <Border x:Name="HoverFrame"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="1"
                                                                CornerRadius="2">
                                                            <ContentPresenter Margin="8,7,4,6" />
                                                        </Border>
                                                        <ToggleButton x:Name="PinToggle"
                                                                      Width="9"
                                                                      Height="9"
                                                                      HorizontalAlignment="Right"
                                                                      VerticalAlignment="Top"
                                                                      Margin="0,1,1,0"
                                                                      Opacity="0"
                                                                      ToolTip="Sposta fra tray e overflow (pin/unpin)"
                                                                      Visibility="Collapsed"
                                                                      IsChecked="{Binding IsPinned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Focusable"
                                                    Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="PinBg"
                                                                Background="Transparent"
                                                                CornerRadius="2"
                                                                Padding="1">
                                                            <Path Data="M1.5,0.5 h5 v3.5 l-1,1 v2.5 l-1.5,1.5 -1.5,-1.5 v-2.5 l-1,-1 z"
                                                                  Stretch="Uniform">
                                                                <Path.Fill>
                                                                    <SolidColorBrush Color="#FF4A4A4A" />
                                                                </Path.Fill>
                                                                <Path.LayoutTransform>
                                                                    <ScaleTransform ScaleX="-1" />
                                                                </Path.LayoutTransform>
                                                            </Path>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Setter TargetName="PinBg"
                                                                        Property="Background"
                                                                        Value="#406EA5D2" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed"
                                                                     Value="True">
                                                                <Setter TargetName="PinBg"
                                                                        Property="Background"
                                                                        Value="#736EA5D2" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked"
                                                                     Value="True">
                                                                <Setter TargetName="PinBg"
                                                                        Property="Background"
                                                                        Value="#66000000" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                                        </ToggleButton>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Setter TargetName="HoverFrame"
                                                                        Property="Background"
                                                                        Value="#266EA5D2" />
                                                                <Setter TargetName="HoverFrame"
                                                                        Property="BorderBrush"
                                                                        Value="#666EA5D2" />
                                                                <Setter TargetName="PinToggle"
                                                                        Property="Opacity"
                                                                        Value="0.9" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Border.Resources>
                                    <DockPanel>
                                        <!-- footer strip, like the real Win7 overflow panel -->
                                        <Border DockPanel.Dock="Bottom"
                                                BorderBrush="#FFDEDEDE"
                                                BorderThickness="0,1,0,0"
                                                Padding="0,4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0"
                                                                     EndPoint="0,1">
                                                    <GradientStop Color="#FFF7F7F7"
                                                                  Offset="0.0" />
                                                    <GradientStop Color="#FFECECEC"
                                                                  Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock x:Name="CustomizeLink"
                                                       Text="Personalizza..."
                                                       FontSize="11"
                                                       Foreground="#FF0066CC"
                                                       Cursor="Hand"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Setter Property="TextDecorations"
                                                                        Value="Underline" />
                                                                <Setter Property="Foreground"
                                                                        Value="#FF0B76D6" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Border Padding="9,9,9,7">
                                            <ItemsControl x:Name="OverflowIcons"
                                                          ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=NotificationArea.UnpinnedIcons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="3" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <!-- ~30px cells, 4 icons per row like Win7 -->
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Margin"
                                                                Value="1,1,1,1" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <controls:NotifyIcon Style="{StaticResource PopupNotifyIcon}"
                                                                             Host="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- nothing hidden -> no chevron -->
                        <DataTrigger Binding="{Binding ElementName=OverflowIcons, Path=HasItems}"
                                     Value="False">
                            <Setter TargetName="OverflowToggle"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                        <!-- edge-aware popup placement -->
                        <DataTrigger Binding="{Binding Path=AppBarEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Top">
                            <Setter TargetName="OverflowPopup"
                                    Property="Placement"
                                    Value="Bottom" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=AppBarEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Left">
                            <Setter TargetName="OverflowPopup"
                                    Property="Placement"
                                    Value="Right" />
                            <Setter TargetName="OverflowToggle"
                                    Property="DockPanel.Dock"
                                    Value="Top" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=AppBarEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Right">
                            <Setter TargetName="OverflowPopup"
                                    Property="Placement"
                                    Value="Left" />
                            <Setter TargetName="OverflowToggle"
                                    Property="DockPanel.Dock"
                                    Value="Top" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ItemsControl"
           x:Key="NotifyIconItems"
           BasedOn="{StaticResource NotifyIconItems}">
        <Setter Property="Margin"
                Value="0,1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <DataTrigger.Setters>
                    <Setter Property="Margin"
                            Value="0" />
                </DataTrigger.Setters>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Horizontal"/>
                    <Condition Binding="{Binding Path=Rows, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                               Value="1"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                    <Setter Property="Margin"
                            Value="0,0,0,2" />
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ToolbarItems unified with TaskList: same WrapPanel, no separator margin -->
    <Style TargetType="ItemsControl"
           x:Key="ToolbarItems"
           BasedOn="{StaticResource ToolbarItems}">
        <Setter Property="Margin" Value="0,0,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <DataTrigger.Setters>
                    <Setter Property="Margin" Value="0,0,0,0" />
                </DataTrigger.Setters>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== SUPERBAR PINNED ITEMS - SAME AREA AS OPEN WINDOWS =====
         Windows 7 Superbar: pinned icons live in the exact same area as
         open windows. When closed: just a transparent icon + glass hover.
         When launched: it turns directly into the active-window button
         (open glass frame + bottom glow), with no duplicate.

         This ToolbarButton style uses EXACTLY the same brushes and template
         as TaskButton, but with a transparent normal state (pinned, closed).
         Hover = bright glass, Pressed = active dark glass + glow.
         Same dimensions as TaskButton (58px) for perfect unification.
    -->
    <Style TargetType="Image" x:Key="ToolbarIcon" BasedOn="{StaticResource TaskIcon}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

        <!-- TOOLBARBUTTON (PINNED CLOSED): hover = same tray rectangles | icon | with accurate dimensions -->
    <Style TargetType="Button" x:Key="ToolbarButton">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
        <Setter Property="Margin" Value="{DynamicResource TaskButtonMargin}" />
        <Setter Property="Width" Value="{DynamicResource TaskButtonWidth}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <!-- PINNED NOT OPEN: widened 7% (52->56) | icon | - tray restored -->
                        <Canvas x:Name="HoverCanvas"
                                Width="0"
                                Height="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Image x:Name="HoverTileImg"
                                   Width="56"
                                   Height="40"
                                   Canvas.Left="-28"
                                   Canvas.Top="-20"
                                   Stretch="Fill"
                                   SnapsToDevicePixels="True"
                                   Source="{DynamicResource TrayTileHoverImage}"
                                   Opacity="0" />
                        </Canvas>
                        <!-- Centered 32px icon -->
                        <ContentPresenter x:Name="Content"
                                          Margin="6,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TrayHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverTileImg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TrayHoverOut">
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop"
                                                         Storyboard.TargetName="HoverTileImg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverTileImg" Property="Source" Value="{DynamicResource TrayTilePressedImage}" />
                            <Setter TargetName="HoverTileImg" Property="Opacity" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <Setter TargetName="HoverCanvas" Property="Margin" Value="0,13,0,0" />
                            <!-- v1.21.24: stesso 2,5% sulla barra verticale (27 -> 26,325). -->
                            <Setter TargetName="HoverTileImg" Property="Height" Value="26.325" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolbarButtonActive keeps the active glass for when a pinned item is running (optional) -->
    <Style TargetType="Button" x:Key="ToolbarButtonActive" BasedOn="{StaticResource TaskButtonActive}">
        <Setter Property="Margin" Value="{DynamicResource TaskButtonMargin}" />
        <Setter Property="Width" Value="{DynamicResource TaskButtonWidth}" />
        <Setter Property="Height" Value="40" />
    </Style>

    

    <!-- ===== SUPERBAR: REMOVING THE SEPARATE QUICK LAUNCH =====
         Windows 7: no grip/separator between pinned items and open windows.
         The Thumb (dotted grip) is collapsed -> a single TaskList+Toolbar area -->
    <Style TargetType="Thumb"
           x:Key="ToolbarThumb"
           BasedOn="{StaticResource ToolbarThumb}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent" Width="0" Height="0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SHOW DESKTOP / AERO PEEK - Win8.1: non e' un asset grafico (era gia'
         cosi' in Win7: un rettangolo generico), qui e' pura geometria XAML,
         nessun PNG. Solo una sottile linea verticale di separazione a bordo
         schermo con hover/pressed overlay, coerente col resto flat del tema. -->
    <Style TargetType="ToggleButton"
           x:Key="ShowDesktopButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <!-- Rettangolo generico: nessuna texture, solo una
                             linea di separazione sottile sul bordo sinistro -->
                        <Border x:Name="AeroPeekRect"
                                Width="15"
                                Height="40"
                                Background="Transparent"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1,0,0,0"
                                SnapsToDevicePixels="True" />
                        <!-- Light hover/pressed overlay -->
                        <Border x:Name="HoverOverlay"
                                Background="#00FFFFFF"
                                Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="6,-5,6,0"
                                          x:Name="Content"
                                          Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Background" Value="#1AFFFFFF" />
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Background" Value="#2AFFFFFF" />
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="15" />
                                <Setter TargetName="AeroPeekRect" Property="Width" Value="40" />
                                <Setter TargetName="AeroPeekRect" Property="Height" Value="15" />
                                <Setter TargetName="AeroPeekRect" Property="BorderThickness" Value="0,1,0,0" />
                                <Setter TargetName="Content" Property="Margin" Value="38,6" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TaskListScrollButtonGrid"
           TargetType="Grid">
        <Setter Property="Margin"
                Value="1,0" />
    </Style>

    <!-- TaskListScrollViewer unified: 0 margin to blend with the Toolbar -->
    <Style x:Key="TaskListScrollViewer"
           TargetType="ScrollViewer"
           BasedOn="{StaticResource TaskListScrollViewer}">
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"
                                                Width="{TemplateBinding Width}"
                                                Height="{TemplateBinding Height}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}" />
                        <Grid Grid.Column="1"
                              Style="{DynamicResource TaskListScrollButtonGrid}"
                              Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <RepeatButton Command="ScrollBar.PageUpCommand"
                                          Style="{DynamicResource TaskListScrollUpButton}"
                                          Grid.Column="0">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RepeatButton}}"
                                      Data="{DynamicResource VArrow}"
                                      RenderTransformOrigin="0.5,0.5"
                                      RenderOptions.EdgeMode="Aliased">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleY="-1" />
                                    </Path.RenderTransform>
                                </Path>
                            </RepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand"
                                          Style="{DynamicResource TaskListScrollDownButton}"
                                          Grid.Row="1">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RepeatButton}}"
                                      Data="{DynamicResource VArrow}"
                                      RenderOptions.EdgeMode="Aliased">
                                </Path>
                            </RepeatButton>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <DataTrigger.Setters>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ScrollContentPresenter Grid.Row="0"
                                                            Width="{TemplateBinding Width}"
                                                            Height="{TemplateBinding Height}"
                                                            CanContentScroll="{TemplateBinding CanContentScroll}"
                                                            Content="{TemplateBinding Content}" />
                                    <Grid Grid.Row="1"
                                          Style="{DynamicResource TaskListScrollButtonGrid}"
                                          Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                      Style="{DynamicResource TaskListScrollUpButton}"
                                                      Padding="7"
                                                      Grid.Column="0">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RepeatButton}}"
                                                  Data="{DynamicResource VArrow}"
                                                  Margin="7"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  RenderOptions.EdgeMode="Aliased">
                                                <Path.RenderTransform>
                                                    <ScaleTransform ScaleY="-1" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </RepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                      Style="{DynamicResource TaskListScrollDownButton}"
                                                      Padding="4"
                                                      Grid.Column="1">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RepeatButton}}"
                                                  Data="{DynamicResource VArrow}"
                                                  Margin="7"
                                                  RenderOptions.EdgeMode="Aliased">
                                            </Path>
                                        </RepeatButton>
                                    </Grid>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Margin" Value="0,0,0,0" />
                </DataTrigger.Setters>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Geometry x:Key="VArrow">M 3.5,4 L 7,0 L 0,0 Z</Geometry>
    <Geometry x:Key="HArrow">M 0,4 L 5,8 L 7.25,8 L 4,4 L 7.25,0 L 5,0 Z</Geometry>

    <Style TargetType="ToggleButton"
           x:Key="TrayToggleButton">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Background"
                Value="{DynamicResource TrayToggleBackground}" />
        <Setter Property="Margin"
                Value="0,0,3,0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <!-- RetroBar sets this chevron's Visibility in code, which a theme
             style cannot override; to drop the built-in expand-in-place button
             (replaced by the simulated Win7 overflow below) it is rendered
             zero-size, invisible, unfocusable and non-hittable instead.
             TrayOverflowButton undoes all of this for its own chevron. -->
        <Setter Property="Opacity"
                Value="0" />
        <Setter Property="IsHitTestVisible"
                Value="False" />
        <Setter Property="Width"
                Value="0" />
        <Setter Property="Height"
                Value="0" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Border BorderThickness="1"
                                BorderBrush="Transparent"
                                CornerRadius="0"
                                HorizontalAlignment="Center"
                                x:Name="ButtonOuterBorder">
                            <Border BorderThickness="1"
                                    BorderBrush="Transparent"
                                    CornerRadius="0"
                                    Background="{TemplateBinding Background}"
                                    HorizontalAlignment="Center"
                                    Padding="{DynamicResource TrayToggleArrowPadding}"
                                    x:Name="ButtonBorder">
                                <Path Fill="{DynamicResource TrayToggleArrowForeground}"
                                      Data="{DynamicResource HArrow}"
                                      RenderOptions.EdgeMode="Unspecified"
                                      x:Name="ToggleArrow" />
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource TrayToggleHoverBackground}" />
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TrayToggleBorder}" />
                            <Setter TargetName="ButtonOuterBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TrayToggleOuterBorder}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource TrayTogglePressedBackground}" />
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TrayToggleBorder}" />
                            <Setter TargetName="ButtonOuterBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TrayToggleOuterBorder}" />
                            <Setter TargetName="ToggleArrow"
                                    Property="Fill"
                                    Value="{DynamicResource TrayToggleArrowPressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="ToggleArrow"
                                    Property="RenderTransformOrigin"
                                    Value="0.6,0.5" />
                            <Setter TargetName="ToggleArrow"
                                    Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="-1"></ScaleTransform>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="ToolTip" Value="{DynamicResource hide}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
                <Setter Property="ToolTip" Value="{DynamicResource show_hidden}" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <DataTrigger.Setters>
                    <Setter Property="Margin"
                            Value="0,0,0,1" />
                </DataTrigger.Setters>
            </DataTrigger>
