        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                           <!-- v1.21.24 - arte 17x17 disegnata all'8% in meno (15,64 DIP);
                                bersaglio di clic invariato a 20x20. Stretch=Uniform perche'
                                ora c'e' una scala (prima era 1:1) e HighQuality perche' con
                                NearestNeighbor una scala frazionaria salterebbe righe. -->
                    <Image x:Name="CloseGlyph"
                           Source="{x:Static bundle:PreviewAssets.Win81PreviewClose}"
                           Width="13.29" Height="13.29" Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <!-- v1.21.27 - X 15% piu' piccola (15.64 -> 13.29 DIP) e
                             2% piu' in alto (3.32 DIP sul riquadro da 166). -->
                        <Image.RenderTransform>
                            <TranslateTransform Y="-3.32" />
                        </Image.RenderTransform>
                    </Image>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CloseGlyph"
                                    Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CloseGlyph"
                                    Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
