    <!-- Bandierina flat Win8.1 al posto dell'orb 3D: stesso sprite sheet
         verticale a 3 righe (normal/hover/pressed, Viewbox 0/0.3333/0.6666
         nel template StartButton piu' sotto - INVARIATO), nuovo asset. -->
    <x:Static x:Key="StartButtonImageBottom" Member="bundle:GraphicalResourceBundle.startwin81flag" />
    <x:Static x:Key="StartButtonImageBottomScaled" Member="bundle:GraphicalResourceBundle.startwin81flagscaled" />
    <x:Static x:Key="StartButtonImageTop" Member="bundle:GraphicalResourceBundle.startwin81flag" />
    <x:Static x:Key="StartButtonImageTopScaled" Member="bundle:GraphicalResourceBundle.startwin81flagscaled" />
    <x:Static x:Key="StartButtonImageLarge" Member="bundle:StartFlagAssets.Sprite" />
    <x:Static x:Key="StartButtonImageLargeScaled" Member="bundle:StartFlagAssets.Sprite" />

    <Style TargetType="MenuItem"
           x:Key="TaskManMenuItem">
        <Setter Property="Header"
                Value="{DynamicResource show_taskman}" />
    </Style>

    <FontFamily x:Key="GlobalFontFamily">Segoe UI</FontFamily>
    <system:Double x:Key="GlobalFontSize">12</system:Double>

    <retroconv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

    <Style TargetType="ToolTip"
           x:Key="{x:Type ToolTip}"
           BasedOn="{StaticResource GlobalFonts}">
        <!-- Same tooltip as the Windows Vista Aero XAML: light gradient, single
             1px border, 2px corner radius -->
        <Setter Property="Background"
                Value="{DynamicResource VistaToolTipBackground}" />
        <Setter Property="Foreground"
                Value="{DynamicResource VistaToolTipForeground}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource VistaToolTipBorder}" />
        <Setter Property="Padding"
                Value="5,2,5,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="2">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Window"
           x:Key="TaskbarWindow"
           BasedOn="{StaticResource TaskbarWindow}">
        <Setter Property="Background"
                Value="{DynamicResource TaskbarWindowBackground}" />
    </Style>

    <!-- ===== TASKBAR WITH PNG TEXTURE + TRANSPARENCY (OpenGlass) ===== -->
    <Style TargetType="ContentControl"
           x:Key="Taskbar"
           BasedOn="{StaticResource Taskbar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <!-- WIN81TASKBAR.PNG 600x40 FLAT TINT (no diagonal reflections) + TRANSPARENCY -->
                    <Border BorderThickness="0"
                            BorderBrush="Transparent"
                            x:Name="TaskbarTopBorder">
                        <Border BorderThickness="0"
                                BorderBrush="Transparent"
                                x:Name="TaskbarTopInnerBorder">
                            <Border BorderThickness="0"
                                    BorderBrush="Transparent"
                                    x:Name="TaskbarBottomBorder">
                                <Border BorderThickness="0"
                                        BorderBrush="Transparent"
                                        Background="Transparent"
                                        x:Name="TaskbarBottomInnerBorder">
                                    <Grid>
                                        <!-- Layer 1: win7taskbar.png 600x40, tinta flat uniforme (nessun
                                             riflesso diagonale ne' texture "vetro" come nel tema Win7) -->
                                        <Border x:Name="TaskbarTextureLayer"
                                                Background="{DynamicResource Win7_TaskbarTextureBrush}" />
                                        <!-- Layer 2: overlay flat semi-opaco. Win8.1 con "rendi trasparenti
                                             la barra e il Centro notifiche" attivo mostra un velo di colore
                                             uniforme piu' coprente della trasparenza estrema di Aero Glass,
                                             quindi qui l'opacita' e' piu' alta (desktop ancora visibile ma
                                             meno "vetro", piu' "tinta"). -->
                                        <Border x:Name="TaskbarGradientLayer"
                                                Background="{DynamicResource TaskbarBackground}"
                                                Opacity="0.55" />
                                        <ContentPresenter Margin="0,-2,0,-2"
                                                          Name="Content" />
                                    </Grid>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="TaskbarTopBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource TaskbarVerticalTopBorder}" />
                                <Setter TargetName="TaskbarTopInnerBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource TaskbarVerticalTopInnerBorder}" />
                                <Setter TargetName="TaskbarBottomBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource TaskbarVerticalBottomBorder}" />
                                <Setter TargetName="TaskbarBottomInnerBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource TaskbarVerticalBottomInnerBorder}" />
                                <Setter TargetName="TaskbarTextureLayer"
                                        Property="Background"
                                        Value="{DynamicResource Win7_Win7_TaskbarTextureBrushVertical}" />
                                <Setter TargetName="TaskbarGradientLayer"
                                        Property="Background"
                                        Value="{DynamicResource TaskbarVerticalBackground}" />
                                <Setter TargetName="TaskbarBottomBorder" Property="BorderThickness" Value="0" />
                                <Setter TargetName="TaskbarTopBorder" Property="BorderThickness" Value="0" />
                                <Setter TargetName="TaskbarTopInnerBorder" Property="BorderThickness" Value="0" />
                                <Setter TargetName="TaskbarBottomInnerBorder" Property="BorderThickness" Value="0" />
                                <Setter TargetName="Content"
                                        Property="Margin"
                                        Value="-1,0,-1,0" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GroupBox"
           x:Key="Tray">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border BorderThickness="0"
                            Padding="8,0,0,0"
                            Name="TrayBorder">
                        <!-- right margin 0: the gap after the last tray icon
                             (toward the clock) is just the icon's own 9px margin,
                             as in the Win7 photo (~6-9px at 100%) -->
                        <ContentPresenter Margin="0,0,0,0"
                                          Name="Content" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="TrayBorder"
                                        Property="Padding"
                                        Value="2,7,2,0" />
                                <Setter TargetName="Content"
                                        Property="Margin"
                                        Value="0,0,0,6" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Windows 7 Superbar task buttons ============
         Structure from the reference Win7 theme (nested glass borders), Win7 state brushes.
         Normal: subtle glass outline; Hover: bright glass; Active: dark glass + lit base;
         Pressed: darker; Flashing: amber with pulse animation. -->
    <Style TargetType="Button"
           x:Key="TaskButton">
        <Setter Property="Foreground"
                Value="{DynamicResource ButtonForeground}" />
        <Setter Property="Margin"
                Value="{DynamicResource TaskButtonMargin}" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- INACTIVE OPEN: wide border (2px) as in the reference Win7 photo -->
                    <Border Background="Transparent"
                            Padding="0"
                            Name="ButtonBorder">
                        <Border BorderThickness="2"
                                BorderBrush="{DynamicResource TaskButtonOuterBorder}"
                                CornerRadius="0"
                                x:Name="ButtonOuterBorder">
                            <Border BorderThickness="2"
                                    BorderBrush="{DynamicResource TaskButtonInnerBorder}"
                                    Background="{DynamicResource TaskButtonBackground}"
                                    CornerRadius="0"
                                    x:Name="ButtonInnerBorder">
                                <Border BorderThickness="0,1,1,0"
                                        BorderBrush="{DynamicResource TaskButtonInnerTopRightBorder}"
                                        CornerRadius="0"
                                        x:Name="ButtonInnerTopRightBorder">
                                    <Border BorderThickness="1,0,0,1"
                                            BorderBrush="{DynamicResource TaskButtonInnerBottomLeftBorder}"
                                            CornerRadius="0"
                                            x:Name="ButtonInnerBottomLeftBorder">
                                        <ContentPresenter Margin="6,0"
                                                          VerticalAlignment="Center"
                                                          x:Name="Content" />
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="ButtonBorder"
                                        Property="Padding"
                                        Value="1,0,1,2" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                        <!-- INACTIVE HOVER: border widened 7% (3px->3px but visually wider) -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ButtonOuterBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonOuterBorderHover}" />
                            <Setter TargetName="ButtonOuterBorder"
                                    Property="BorderThickness"
                                    Value="2" />
                            <Setter TargetName="ButtonInnerBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBorderHover}" />
                            <Setter TargetName="ButtonInnerBorder"
                                    Property="BorderThickness"
                                    Value="2" />
                            <Setter TargetName="ButtonInnerTopRightBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerTopRightBorderHover}" />
                            <Setter TargetName="ButtonInnerTopRightBorder"
                                    Property="BorderThickness"
                                    Value="1,1,1,0" />
                            <Setter TargetName="ButtonInnerBottomLeftBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBottomLeftBorderHover}" />
                            <Setter TargetName="ButtonInnerBottomLeftBorder"
                                    Property="BorderThickness"
                                    Value="0,0,0,1" />
                            <Setter TargetName="ButtonInnerBorder"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBackgroundHover}" />
                            <Setter TargetName="ButtonOuterBorder"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBottomBackgroundHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ButtonPressedForeground}" />
                            <Setter TargetName="ButtonOuterBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonOuterBorderActive}" />
                            <Setter TargetName="ButtonInnerBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBorderActive}" />
                            <Setter TargetName="ButtonInnerTopRightBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerTopRightBorderActive}" />
                            <Setter TargetName="ButtonInnerBottomLeftBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBottomLeftBorderActive}" />
                            <Setter TargetName="ButtonInnerBorder"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBackgroundPressed}" />
                            <Setter TargetName="ButtonOuterBorder"
                                    Property="Background"
                                    Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ACTIVE: taller border (extends to the taskbar edge, not short) -->
    <Style TargetType="Button"
           x:Key="TaskButtonActive"
           BasedOn="{StaticResource TaskButton}">
        <Setter Property="Foreground"
                Value="{DynamicResource ButtonActiveForeground}" />
        <Setter Property="Margin"
                Value="1,1,1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent"
                            Padding="0,0,0,1"
                            Name="ButtonBorder">
                        <Grid>
                            <Border BorderThickness="1,1,1,0"
                                    BorderBrush="{DynamicResource TaskButtonOuterBorderActive}"
                                    Background="{DynamicResource TaskButtonBottomBackgroundActive}"
                                    CornerRadius="0,0,0,0"
                                    x:Name="ButtonOuterBorder">
                                <Border BorderThickness="1,1,1,0"
                                        BorderBrush="{DynamicResource TaskButtonInnerBorderActive}"
                                        Background="{DynamicResource TaskButtonBackgroundActive}"
                                        CornerRadius="0,0,0,0"
                                        x:Name="ButtonInnerBorder">
                                    <Border BorderThickness="0,1,1,0"
                                            BorderBrush="{DynamicResource TaskButtonInnerTopRightBorderActive}"
                                            CornerRadius="0,0,0,0"
                                            x:Name="ButtonInnerTopRightBorder">
                                        <Border BorderThickness="1,0,0,0"
                                                BorderBrush="{DynamicResource TaskButtonInnerBottomLeftBorderActive}"
                                                CornerRadius="0,0,0,0"
                                                x:Name="ButtonInnerBottomLeftBorder">
                                            <ContentPresenter Margin="6,0,6,1"
                                                              VerticalAlignment="Center"
                                                              x:Name="Content" />
                                        </Border>
                                    </Border>
                                </Border>
                            </Border>
                            <!-- Specular highlight strip: the crisp bright line Win7
                                 shows right at the bottom edge of an active/open
                                 taskbar button, on top of the soft radial glow -->
                            <Rectangle Height="2"
                                       VerticalAlignment="Bottom"
                                       Margin="1,0,1,0"
                                       Fill="{DynamicResource TaskButtonBottomHighlightActive}"
                                       x:Name="BottomHighlight" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="ButtonBorder"
                                        Property="Padding"
                                        Value="1,0,1,2" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ButtonInnerBorder"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBackgroundActiveHover}" />
                            <Setter TargetName="ButtonOuterBorder"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBottomBackgroundActiveHover}" />
                            <Setter TargetName="BottomHighlight"
                                    Property="Fill"
                                    Value="{DynamicResource TaskButtonBottomHighlightActiveHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ButtonPressedForeground}" />
                            <Setter TargetName="ButtonInnerBorder"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBackgroundPressed}" />
                            <Setter TargetName="ButtonOuterBorder"
                                    Property="Background"
                                    Value="Transparent" />
                            <Setter TargetName="BottomHighlight"
                                    Property="Opacity"
                                    Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button"
           x:Key="TaskButtonFlashing"
           BasedOn="{StaticResource TaskButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent"
                            Padding="0"
                            Name="ButtonBorder">
                        <Border BorderThickness="1"
                                BorderBrush="{DynamicResource TaskButtonOuterBorderFlashing}"
                                Background="{DynamicResource TaskButtonBottomBackgroundFlashing}"
                                CornerRadius="0"
                                x:Name="ButtonOuterBorder">
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource TaskButtonInnerBorderFlashing}"
                                    Background="{DynamicResource TaskButtonBackgroundFlashing}"
                                    CornerRadius="0"
                                    x:Name="ButtonInnerBorder">
                                <Border BorderThickness="0,1,1,0"
                                        BorderBrush="{DynamicResource TaskButtonInnerTopRightBorderFlashing}"
                                        CornerRadius="0"
                                        x:Name="ButtonInnerTopRightBorder">
                                    <Border BorderThickness="1,0,0,1"
                                            BorderBrush="{DynamicResource TaskButtonInnerBottomLeftBorderFlashing}"
                                            CornerRadius="0"
                                            x:Name="ButtonInnerBottomLeftBorder">
                                        <Grid>
                                            <Border Background="{DynamicResource TaskButtonFlashPulseOverlay}"
                                                    CornerRadius="0"
                                                    Opacity="0.2"
                                                    IsHitTestVisible="False"
                                                    x:Name="FlashPulse" />
                                            <ContentPresenter Margin="6,0"
                                                              VerticalAlignment="Center"
                                                              x:Name="Content" />
                                        </Grid>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="ButtonBorder"
                                        Property="Padding"
                                        Value="1,0,1,2" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ButtonPressedForeground}" />
                            <Setter TargetName="ButtonInnerBorder"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBackgroundPressed}" />
                            <Setter TargetName="ButtonOuterBorder"
                                    Property="Background"
                                    Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FlashPulseStoryboard">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlashPulse"
                                                                       Storyboard.TargetProperty="Opacity"
                                                                       RepeatBehavior="Forever">
                                            <LinearDoubleKeyFrame Value="0.1"
                                                                  KeyTime="0:0:0" />
                                            <LinearDoubleKeyFrame Value="0.55"
                                                                  KeyTime="0:0:0.35" />
                                            <LinearDoubleKeyFrame Value="0.1"
                                                                  KeyTime="0:0:0.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FlashPulseStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContentControl"
           x:Key="TaskButtonThumbnail">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <!-- v2.51: questa cornice non e' piu' quella usata
                         dall'anteprima viva (al suo posto TaskPreviewFrameVista
                         in Themes/Overrides.xaml); il margine torna al valore
                         originale del tema. -->
                    <Border BorderBrush="{DynamicResource TaskButtonThumbnailBorder}"
                            BorderThickness="1"
                            Background="{DynamicResource TaskButtonThumbnailBackground}"
                            CornerRadius="6"
                            Margin="4"
                            Effect="{DynamicResource TaskButtonThumbnailShadow}">
                        <Border BorderBrush="{DynamicResource TaskButtonThumbnailInnerBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="3">
                            <Border BorderBrush="{DynamicResource TaskButtonThumbnailInnerBorder}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <Border BorderBrush="{DynamicResource TaskButtonThumbnailThumbBorder}"
                                        BorderThickness="1"
                                        CornerRadius="1">
                                    <ContentPresenter />
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TaskListScrollUpButton"
           TargetType="RepeatButton"
           BasedOn="{StaticResource TaskListScrollButton}">
        <Setter Property="Foreground"
                Value="{DynamicResource TaskListScrollArrow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border BorderThickness="1,1,1,0"
                            BorderBrush="{DynamicResource TaskListScrollButtonOuterBorder}"
                            CornerRadius="{DynamicResource TaskListScrollUpCornerRadius}"
                            x:Name="ButtonOuterBorder">
                        <Border BorderThickness="1,1,1,0"
                                BorderBrush="{DynamicResource TaskListScrollButtonBorder}"
                                Background="{DynamicResource TaskListScrollButtonBackground}"
                                x:Name="ButtonBorder">
                            <Border BorderThickness="1"
                                    BorderBrush="Transparent"
                                    x:Name="ButtonInnerBorder">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="2,-5,2,-2"
                                                  x:Name="Content" />
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ButtonInnerBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskListScrollButtonInnerBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="ButtonInnerBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskListScrollButtonInnerBorderPressed}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="ButtonOuterBorder"
                                        Property="BorderThickness"
                                        Value="1,1,0,1" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderThickness"
                                        Value="1,1,0,1" />
                                <Setter TargetName="ButtonOuterBorder"
                                        Property="CornerRadius"
                                        Value="{DynamicResource TaskListScrollLeftCornerRadius}" />
                                <Setter TargetName="Content"
                                        Property="Margin"
                                        Value="2,-4,2,-3" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Trigger.Setters>
                    <Setter Property="Foreground"
                            Value="{DynamicResource TaskListScrollArrowHover}" />
                </Trigger.Setters>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TaskListScrollDownButton"
           TargetType="RepeatButton"
           BasedOn="{StaticResource TaskListScrollButton}">
        <Setter Property="Foreground"
                Value="{DynamicResource TaskListScrollArrow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border BorderThickness="1,0,1,1"
                            BorderBrush="{DynamicResource TaskListScrollButtonOuterBorder}"
                            CornerRadius="{DynamicResource TaskListScrollDownCornerRadius}"
                            x:Name="ButtonOuterBorder">
                        <Border BorderThickness="1,0,1,1"
                                BorderBrush="{DynamicResource TaskListScrollButtonBorder}"
                                Background="{DynamicResource TaskListScrollButtonBackground}"
                                x:Name="ButtonBorder">
                            <Border BorderThickness="1"
                                    BorderBrush="Transparent"
                                    x:Name="ButtonInnerBorder">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="2,-2,2,-5"
                                                  x:Name="Content" />
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ButtonInnerBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskListScrollButtonInnerBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="ButtonInnerBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskListScrollButtonInnerBorderPressed}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="ButtonOuterBorder"
                                        Property="BorderThickness"
                                        Value="0,1,1,1" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderThickness"
                                        Value="0,1,1,1" />
                                <Setter TargetName="ButtonOuterBorder"
                                        Property="CornerRadius"
                                        Value="{DynamicResource TaskListScrollRightCornerRadius}" />
                                <Setter TargetName="Content"
                                        Property="Margin"
                                        Value="2,-3,2,-4" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Trigger.Setters>
                    <Setter Property="Foreground"
                            Value="{DynamicResource TaskListScrollArrowHover}" />
                </Trigger.Setters>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ToolTip x:Key="StartButtonTip" Content="{DynamicResource start_button_tip_vista}" />

    <!-- Windows 8.1 Start flag (v1.21.21). La cella dello sprite e' 54x54 e
         viene disegnata 1:1; la casella e' 53 DIP, circa il 2% in meno (misura
         che corrisponde alla bandierina di Windows 8.1, piu' piccola di quella
         di Windows 7), con 1 DIP di spostamento a sinistra (l'1,5% circa) e lo
         stesso Margin verticale -6 dell'orb di Windows 7. La cella e' piu' alta
         della barra da 40px: la parte visibile e' quella che serve alle tre
         righe (idle: bandierina 30x28 centrata; hover/pressed: piastrella a
         tutta larghezza, a filo barra).
         Le due righe hover/pressed hanno i quattro riquadri della bandierina
         RITAGLIATI (trasparenti): lo strato "OrbCutOutFill" li riempie con il
         colore di accento di Windows, quindi dentro la piastrella si vede la
         tinta del sistema - non il bianco della bandierina a riposo, e non un
         buco che lascia sparire la barra. Riferimento: il pulsante Start di
         Open-Shell, che si disegna da solo la piastrella e la bandierina
         ritagliata invece di sovrapporre due stati dello stesso sprite.
         Il riempimento compare con un setter statico (nessuna animazione),
         quindi il passaggio idle -> hover/pressed e' netto, come su Windows
         8.1: nessun fade dello stato precedente e nessun istante senza tema. -->
    <Style TargetType="ToggleButton"
           x:Key="StartButton">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Foreground"
                Value="{DynamicResource ItemButtonForeground}" />
        <Setter Property="Margin"
                Value="-1,-6,0,-6" />
        <Setter Property="Width"
                Value="53" />
        <Setter Property="Height"
                Value="53" />
        <Setter Property="HorizontalAlignment"
                Value="Left" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid RenderOptions.BitmapScalingMode="HighQuality">
                        <Border x:Name="OrbNormal"
                                FlowDirection="LeftToRight">
                            <Border.Background>
                                <ImageBrush ImageSource="{DynamicResource StartButtonImageLarge}"
                                            ViewboxUnits="RelativeToBoundingBox"
                                            Viewbox="0,0,1,0.3333" />
                            </Border.Background>
                        </Border>
                        <!-- v1.21.21: riempie i ritagli trasparenti delle righe
                             hover/pressed con il colore di accento di Windows
                             (la stessa tinta letta dal vivo per le anteprime,
                             aggiornata dal programma quando il colore dietro
                             cambia). Sta SOPRA la bandierina a riposo e SOTTO
                             la piastrella, quindi si vede solo attraverso il
                             ritaglio. Nessuna animazione: compare netto. -->
                        <Border x:Name="OrbCutOutFill"
                                Opacity="0"
                                FlowDirection="LeftToRight"
                                Background="{DynamicResource DwmPreviewAccentBrush}" />
                        <Border x:Name="OrbHover"
                                Opacity="0"
                                FlowDirection="LeftToRight">
                            <Border.Background>
                                <ImageBrush ImageSource="{DynamicResource StartButtonImageLarge}"
                                            ViewboxUnits="RelativeToBoundingBox"
                                            Viewbox="0,0.3333,1,0.3333" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="OrbPressed"
                                Opacity="0"
                                FlowDirection="LeftToRight">
                            <Border.Background>
                                <ImageBrush ImageSource="{DynamicResource StartButtonImageLarge}"
                                            ViewboxUnits="RelativeToBoundingBox"
                                            Viewbox="0,0.6666,1,0.3333" />
                            </Border.Background>
                        </Border>
                        <ContentPresenter Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- HOVER (v1.21.21): niente cross-fade. Il pulsante
                             Start di Windows 8.1 non sfuma: mostra lo stato
                             hover e basta, e il pulsante di Open-Shell fa la
                             stessa cosa (disegna UNA sola immagine di stato:
                             premuto -> pressed, altrimenti hot o normal, mai
                             due sovrapposte). Due setter statici, quindi il
                             cambio e' immediato e nessun valore animato puo'
                             restare appeso (era la causa del "per un attimo si
                             perde il tema"). All'uscita dal trigger WPF
                             riporta i due strati al valore scritto
                             nell'elemento, cioe' 0: nessuna animazione da
                             fermare, nessun ritardo. -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="OrbCutOutFill"
                                    Property="Opacity"
                                    Value="1" />
                            <Setter TargetName="OrbHover"
                                    Property="Opacity"
                                    Value="1" />
                        </Trigger>
                        <!-- pressed while clicked -->
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="OrbPressed"
                                    Property="Opacity"
                                    Value="1" />
                            <!-- v1.21.21: come l'hover: anche da premuto il
                                 ritaglio e' riempito dall'accento. -->
                            <Setter TargetName="OrbCutOutFill"
                                    Property="Opacity"
                                    Value="1" />
                        </Trigger>
                        <!-- MENU START APERTO: il pulsante resta nello stato
                             premuto finche' il menu e' aperto.
                             Lo stato e' fatto di SETTER STATICI, non di
                             animazioni: un valore animato e' guidato da un
                             Clock che puo' restare "appeso" e, dopo qualche
                             secondo o un cambio di layout, essere invalidato -
                             facendo riapparire lo stato normale mentre IsChecked
                             e' ancora vero. Da v1.21.21 anche l'hover e' fatto di
                             setter statici, quindi non c'e' piu' nessuno
                             storyboard da fermare e nessun valore animato in
                             volo: la sequenza idle -> hover -> premuto segue il
                             puntatore senza lampi. OrbPressed e' dichiarato DOPO
                             OrbHover nel Grid, quindi a opacita' 1 copre
                             comunque l'hover; allo stesso modo OrbCutOutFill
                             resta acceso in tutti e tre gli stati attivi. -->
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="OrbPressed"
                                    Property="Opacity"
                                    Value="1" />
                            <Setter TargetName="OrbNormal"
                                    Property="Opacity"
                                    Value="0" />
                            <Setter TargetName="OrbHover"
                                    Property="Opacity"
                                    Value="0" />
                            <Setter TargetName="OrbCutOutFill"
                                    Property="Opacity"
                                    Value="1" />
                        </Trigger>
                        <!-- scaled DPI: point all three layers at the hi-res sprite -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsScaled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                           Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter TargetName="OrbNormal"
                                        Property="Background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{DynamicResource StartButtonImageLargeScaled}"
                                                    ViewboxUnits="RelativeToBoundingBox"
                                                    Viewbox="0,0,1,0.3333" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="OrbHover"
                                        Property="Background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{DynamicResource StartButtonImageLargeScaled}"
                                                    ViewboxUnits="RelativeToBoundingBox"
                                                    Viewbox="0,0.3333,1,0.3333" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="OrbPressed"
                                        Property="Background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{DynamicResource StartButtonImageLargeScaled}"
                                                    ViewboxUnits="RelativeToBoundingBox"
                                                    Viewbox="0,0.6666,1,0.3333" />
                                    </Setter.Value>
                                </Setter>
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <DataTrigger.Setters>
                    <Setter Property="HorizontalAlignment"
                            Value="Center" />
                    <Setter Property="Margin"
                            Value="0,0,0,2" />
                </DataTrigger.Setters>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Image"
           x:Key="TaskIcon"
           BasedOn="{StaticResource TaskIcon}">
        <Setter Property="Width"
                Value="32" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="Margin"
                Value="0,0,4,0" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="RenderOptions.BitmapScalingMode"
                Value="HighQuality" />
        <Setter Property="UseLayoutRounding"
                Value="True" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Style.Triggers>
            <!-- With the label collapsed (combined mode) the icon fills the
                 button alone; a 4px left margin keeps it centered in the
                 58px Superbar button (13px of glass per side) -->
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Horizontal">
                <DataTrigger.Setters>
                    <Setter Property="Margin"
                            Value="4,0,0,0" />
