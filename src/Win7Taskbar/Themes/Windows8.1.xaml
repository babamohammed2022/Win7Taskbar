<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:RetroBar.Controls;assembly=RetroBar"
                    xmlns:retroconv="clr-namespace:RetroBar.Converters;assembly=RetroBar"
                    xmlns:retrosettings="clr-namespace:RetroBar.Utilities;assembly=RetroBar"
                    xmlns:bundle="clr-namespace:Win7Taskbar.Utilities;assembly=Win7Taskbar">

    <!-- 1.21.5: ";assembly=Win7Taskbar" above is REQUIRED, do not remove it.
         Without the assembly qualifier, XamlReader.Load cannot resolve this
         namespace at runtime and every x:Static below dies inside
         StaticExtension.ProvideValue (startup crash "Line number '10'"). -->

    <!-- Win8.1 Superbar height at 96 DPI. Variante derivata da Windows7.xaml:
         stessa struttura, stesso meccanismo (template/trigger/binding invariati).
         Quasi tutti gli asset grafici (bordi/texture/tile overflow-tray-clock)
         sono generici e vengono RIUSATI dal bundle Win7 con lo stesso nome.
         Cambia solo cio' che e' davvero diverso in Win8.1: il pulsante Start
         (nuovo asset "startwin81flag"), l'Aero Peek/Show Desktop (qui ridotto
         a pura geometria XAML, niente PNG) e la trasparenza (colori flat). -->

    <!-- ===== Windhawk overflow resources: PNGs from the Resources folder =====
         Riusati identici dal bundle Win7 (chevron + tile generiche, nessuna
         differenza reale in Win8.1). -->
    <x:Static x:Key="OverflowArrowImage" Member="bundle:GraphicalResourceBundle.win7_overflow_arrow" />
    <x:Static x:Key="OverflowTileHoverImage" Member="bundle:GraphicalResourceBundle.win7_overflow_tilehover" />
    <x:Static x:Key="OverflowTilePressedImage" Member="bundle:GraphicalResourceBundle.win7_overflow_tilepressed" />

    <!-- User-supplied 236x166 DWM preview frame. Riusato identico dal bundle
         Win7: i bordi aero delle anteprime esistevano anche in Win8.1. Stesso
         meccanismo di slicing di Overrides.xaml. -->
    <x:Static x:Key="DwmPreviewBorderImage" Member="bundle:GraphicalResourceBundle.dwmborder" />
    <!-- Alpha-only fallback until TaskbarWindow derives an in-memory
         luminance-times-alpha mask from the same unchanged PNG. -->
    <x:Static x:Key="DwmPreviewBorderMaskImage" Member="bundle:GraphicalResourceBundle.dwmborder" />

    <!-- TASKBAR BACKGROUND - v1.21.21: la barra di Windows 8.1 NON ha la
         texture di vetro Aero (niente riflessi diagonali, niente gradiente a
         piu' fermate): e' una trasparenza GENERICA, piatta e uniforme, che
         lascia passare il desktop sempre allo stesso modo. La PNG della
         texture resta nel bundle per il tema Windows 7; qui le due chiavi
         usate dal template ("Win7_TaskbarTextureBrush" e la variante verticale)
         sono ridichiarate come tinta piatta, cosi' il template non cambia di
         una riga. -->
    <x:Static x:Key="TaskbarBackgroundImage" Member="bundle:GraphicalResourceBundle.taskbarbackground" />
    <ImageBrush x:Key="TaskbarTextureBrush"
                ImageSource="{DynamicResource TaskbarBackgroundImage}"
                TileMode="Tile"
                Viewport="0,0,1,40"
                ViewportUnits="Absolute"
                Stretch="Fill"
                Opacity="1" />
    <ImageBrush x:Key="Win7_TaskbarTextureBrushVertical"
                ImageSource="{DynamicResource TaskbarBackgroundImage}"
                TileMode="Tile"
                Viewport="0,0,60,1"
                ViewportUnits="Absolute"
                Stretch="Fill"
                Opacity="1" />
    <x:Static x:Key="Win7_ShowDesktopImage" Member="bundle:GraphicalResourceBundle.win7showdesktop" />
    <x:Static x:Key="Win7_ShowDesktopImageScaled" Member="bundle:GraphicalResourceBundle.win7showdesktop" />
    <x:Static x:Key="Win7_TaskbarTextureImage" Member="bundle:GraphicalResourceBundle.win7taskbar" />
    <SolidColorBrush x:Key="Win7_TaskbarTextureBrush" Color="#33000000" />
    <SolidColorBrush x:Key="Win7_Win7_TaskbarTextureBrushVertical" Color="#33000000" />



    <!-- ===== RESOURCE SET FROM https://github.com/ramensoftware/windows-11-taskbar-styling-guide/tree/main/Themes/Windows7/ThemeResources =====
         Riusate identiche dal bundle Win7: non risultano referenziate da
         nessun template attivo in questo file (set di riferimento orfano),
         quindi nessuna ragione di duplicarle con nuovi asset Win8.1. -->
    <x:Static x:Key="Win7_ActiveNormalImage" Member="bundle:GraphicalResourceBundle.win7_activenormal" />
    <x:Static x:Key="Win7_InactiveNormalImage" Member="bundle:GraphicalResourceBundle.win7_inactivenormal" />
    <x:Static x:Key="Win7_InactivePointerOverImage" Member="bundle:GraphicalResourceBundle.win7_inactivepointerover" />
    <x:Static x:Key="Win7_NotRunningPointerOverImage" Member="bundle:GraphicalResourceBundle.win7_notrunningpointerover" />
    <x:Static x:Key="Win7_NotRunningPressedImage" Member="bundle:GraphicalResourceBundle.win7_notrunningpressed" />
    <x:Static x:Key="Win7_RequestingAttentionImage" Member="bundle:GraphicalResourceBundle.win7_requestingattention" />
    <x:Static x:Key="Win7_DesktopNormalImage" Member="bundle:GraphicalResourceBundle.win7_desktopnormal" />
    <x:Static x:Key="Win7_DesktopPointerOverImage" Member="bundle:GraphicalResourceBundle.win7_desktoppointerover" />
    <x:Static x:Key="Win7_DesktopPressedImage" Member="bundle:GraphicalResourceBundle.win7_desktoppressed" />
    <x:Static x:Key="Win7_SearchImage" Member="bundle:GraphicalResourceBundle.win7_search" />
    <x:Static x:Key="Win7_TaskViewImage" Member="bundle:GraphicalResourceBundle.win7_taskview" />
    <x:Static x:Key="Win7_WidgetsPointerOverImage" Member="bundle:GraphicalResourceBundle.win7_widgetspointerover" />
    <x:Static x:Key="Win7_WidgetsPressedImage" Member="bundle:GraphicalResourceBundle.win7_widgetspressed" />
    <x:Static x:Key="Win7_AeroPeekImage" Member="bundle:GraphicalResourceBundle.win7_aeropeek" />
    <x:Static x:Key="Win7_AeroPeekBlueImage" Member="bundle:GraphicalResourceBundle.win7_aeropeekblue" />
    <x:Static x:Key="Win7_OverflowNormalImage" Member="bundle:GraphicalResourceBundle.win7_overflownormal" />
    <x:Static x:Key="Win7_OverflowPointerOverImage" Member="bundle:GraphicalResourceBundle.win7_overflowpointerover" />
    <x:Static x:Key="Win7_OverflowPressedImage" Member="bundle:GraphicalResourceBundle.win7_overflowpressed" />
    <x:Static x:Key="Win7_TrayPointerOverImage" Member="bundle:GraphicalResourceBundle.win7_traypointerover" />
    <x:Static x:Key="Win7_TrayPressedImage" Member="bundle:GraphicalResourceBundle.win7_traypressed" />
    <x:Static x:Key="Win7_ClockPointerOverImage" Member="bundle:GraphicalResourceBundle.win7_clockpointerover" />
    <x:Static x:Key="Win7_ClockPressedImage" Member="bundle:GraphicalResourceBundle.win7_clockpressed" />
    <!-- Win7_Orb*Image/Brush sotto sono orfani anch'essi (il vero pulsante
         Start usa StartButtonImageLarge, gia' aggiornato a startwin81flag
         piu' in basso nel file) - riusati identici per coerenza. -->
    <x:Static x:Key="Win7_OrbNormalImage" Member="bundle:GraphicalResourceBundle.win7_orbnormal" />
    <x:Static x:Key="Win7_OrbHoverImage" Member="bundle:GraphicalResourceBundle.win7_orbhover" />
    <x:Static x:Key="Win7_OrbPressedImage" Member="bundle:GraphicalResourceBundle.win7_orbpressed" />

    <ImageBrush x:Key="Win7_ActiveNormalBrush" ImageSource="{StaticResource Win7_ActiveNormalImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_InactiveNormalBrush" ImageSource="{StaticResource Win7_InactiveNormalImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_InactivePointerOverBrush" ImageSource="{StaticResource Win7_InactivePointerOverImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_NotRunningPointerOverBrush" ImageSource="{StaticResource Win7_NotRunningPointerOverImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_NotRunningPressedBrush" ImageSource="{StaticResource Win7_NotRunningPressedImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_RequestingAttentionBrush" ImageSource="{StaticResource Win7_RequestingAttentionImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_DesktopNormalBrush" ImageSource="{StaticResource Win7_DesktopNormalImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_DesktopPointerOverBrush" ImageSource="{StaticResource Win7_DesktopPointerOverImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_DesktopPressedBrush" ImageSource="{StaticResource Win7_DesktopPressedImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_OverflowNormalBrush" ImageSource="{StaticResource Win7_OverflowNormalImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_OverflowPointerOverBrush" ImageSource="{StaticResource Win7_OverflowPointerOverImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_OverflowPressedBrush" ImageSource="{StaticResource Win7_OverflowPressedImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_TrayPointerOverBrush" ImageSource="{StaticResource Win7_TrayPointerOverImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_TrayPressedBrush" ImageSource="{StaticResource Win7_TrayPressedImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_ClockPointerOverBrush" ImageSource="{StaticResource Win7_ClockPointerOverImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_ClockPressedBrush" ImageSource="{StaticResource Win7_ClockPressedImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_OrbNormalBrush" ImageSource="{StaticResource Win7_OrbNormalImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_OrbHoverBrush" ImageSource="{StaticResource Win7_OrbHoverImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_OrbPressedBrush" ImageSource="{StaticResource Win7_OrbPressedImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_AeroPeekBrush" ImageSource="{StaticResource Win7_AeroPeekImage}" Stretch="Fill" Opacity="0.9" />
    <ImageBrush x:Key="Win7_AeroPeekBlueBrush" ImageSource="{StaticResource Win7_AeroPeekBlueImage}" Stretch="Fill" Opacity="0.9" />


    <!-- Win7 TRAY/CLOCK real hover (PNG from the Windhawk Win7 skin in
         ../Resources): NOT rectangles — just the two vertical "whiskers" of
         light on the sides | icon | with a glow at the bottom. Rest: INVISIBLE. -->
    <!-- v1.21.23 - skin 8.1: l'hover torna quello Windows 7.
         Le due tessere rettangolari piatte della 1.21.22 toglievano il
         passaggio del mouse alle icone della barra e dell'area di notifica
         (l'effetto che la v2.53 aveva gia' corretto nel tema Windows 7): qui
         tornano gli asset del bundle, cioe' i due "baffi" verticali di luce ai
         lati dell'icona con il bagliore in basso. Sono ImageSource (non
         pennelli) perche' la stessa chiave serve sia il Background/ImageBrush
         dei pulsanti della barra sia Image.Source delle icone dell'area di
         notifica, quindi una sola chiave copre entrambi. -->
    <x:Static x:Key="TrayTileHoverImage" Member="bundle:GraphicalResourceBundle.win7_tray_tilehover" />
    <x:Static x:Key="TrayTilePressedImage" Member="bundle:GraphicalResourceBundle.win7_tray_tilepressed" />
    <!-- v1.7.3: the soft-edged vertical strip for the window-count
         separators (3x43, feathered alpha). v1.7.4: the file previously
         lived only in the repo-root Resources folder, which the project
         never copies to the output - THAT was why every loading mechanism
         found nothing. It now sits next to the tile PNGs that demonstrably
         ship and render via GraphicalResourceBundle (no loose PNG URI). -->
    <x:Static x:Key="Win7_WindowStackBorderImage" Member="bundle:GraphicalResourceBundle.multiplewindowborder" />
    <x:Static x:Key="ClockTileHoverImage" Member="bundle:GraphicalResourceBundle.win7_clock_tilehover" />
    <x:Static x:Key="ClockTilePressedImage" Member="bundle:GraphicalResourceBundle.win7_clock_tilepressed" />

    <system:Double x:Key="TaskbarHeight">40</system:Double>
    <system:Double x:Key="TaskbarRowHeight">34</system:Double>
    <system:Double x:Key="TaskbarWidth">60</system:Double>
    <system:Boolean x:Key="AllowsTransparency">True</system:Boolean>
    <!-- Win8.1: la bandierina e' flush nella taskbar, non sporge come l'orb Aero. -->
    <system:Boolean x:Key="UseFloatingStartButton">False</system:Boolean>
    <system:Boolean x:Key="UseLargeIcons">True</system:Boolean>
    <!-- Combine-like horizontal buttons (icon-only, as in the vertical layout):
         58px like the Win7 Superbar button = 32px icon + 13px glass per side -->
    <system:Double x:Key="TaskButtonWidth">58</system:Double>
    <system:Double x:Key="TaskButtonMinWidth">50</system:Double>
    <!-- 1px vertical gap so the 40px glass buttons breathe inside the 40px bar -->
    <Thickness x:Key="TaskButtonMargin" Left="1" Top="1" Right="1" Bottom="1" />
    <FontWeight x:Key="SetTimeMenuItemWeight">Normal</FontWeight>
    <!-- Windows 7 Aero glass: black glass tint with the subtle top reflection
         band, over DWM blur (AllowBlurBehind) or straight transparency. -->
    <!-- OpenGlass-style: lighter tint, more desktop showing through transparency -->
    <!-- VERY SOFT TRANSPARENCY: desktop almost clean -->
        <!-- FLAT NEUTRAL OVERLAY - Win8.1: niente vetro Aero col riflesso in alto
         e l'ombra in basso, solo una tinta piatta e uniforme (no gradiente a
         piu' fermate) che lascia intravedere il desktop in modo costante. -->
    <SolidColorBrush x:Key="TaskbarBackground" Color="#26000000" />
    <SolidColorBrush x:Key="TaskbarVerticalBackground" Color="#26000000" />
    <SolidColorBrush x:Key="TaskbarWindowBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TaskbarTopBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TaskbarTopInnerBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TaskbarBottomInnerBorder" Color="Transparent" />
    <!-- Fully transparent pixels (alpha 0) are not hit-testable in an
         AllowsTransparency window, so the last pixel row dropped clicks onto
         the desktop (opening the desktop context menu). Alpha 1 is invisible
         but still catches clicks right up to the screen edge. -->
    <SolidColorBrush x:Key="TaskbarBottomBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TaskbarVerticalTopBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TaskbarVerticalTopInnerBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TaskbarVerticalBottomInnerBorder" Color="Transparent" />
    <!-- Same pass-through fix for the screen-edge column of a vertical taskbar -->
    <SolidColorBrush x:Key="TaskbarVerticalBottomBorder" Color="Transparent" />

    <SolidColorBrush x:Key="TrayToggleOuterBorder" Color="#20ffffff" />
    <!-- resolves a reference inherited from the Vista base theme; Transparent
         keeps the tray toggle visually identical to Vista -->
    <SolidColorBrush x:Key="TrayToggleBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TrayToggleBorder" Color="#99000000" />
    <!-- Win8.1: stessa coppia di toni (blu scuro hover, blu piu' scuro
         pressed) ma piatta, senza la doppia fascia a "cerniera" del tema Win7. -->
    <SolidColorBrush x:Key="TrayToggleHoverBackground" Color="#3a4975" />
    <SolidColorBrush x:Key="TrayTogglePressedBackground" Color="#202c70" />
    <SolidColorBrush x:Key="TrayToggleArrowForeground" Color="#e4e6ec" />
    <SolidColorBrush x:Key="TrayToggleArrowPressed" Color="#dadbdd" />
    <Thickness x:Key="TrayToggleArrowPadding" Left="4" Top="4" Right="5" Bottom="4" />

    <!-- ================= Windows 7 Superbar button brushes ================= -->
    <!-- Normal: barely-there glass outline, always visible on the bar -->
    <!-- Normal state: subtle glass outline (values from the reference Win7 theme) -->
    <!-- ===== TASK BUTTON: Win8.1 flat, niente bevel/riflesso "vetro".
         Ogni gradiente multi-fermata del tema Win7 (riflesso in alto,
         ombra in basso, glow radiale alla base) diventa qui un SolidColorBrush
         unico o al massimo un gradiente a 2 fermate, mantenendo la stessa
         tinta/intento cromatico di base (hover chiaro, active blu accent,
         pressed piu' scuro, flashing ambra) ma senza superfici curve o
         riflessi luminosi. I bordi "TopRight/BottomLeft" (bevel) diventano
         Transparent: nel flat design non c'e' rilievo. -->
    <SolidColorBrush x:Key="TaskButtonOuterBorder" Color="#44000000" />
    <SolidColorBrush x:Key="TaskButtonInnerBorder" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="TaskButtonInnerTopRightBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerBottomLeftBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonBackground" Color="#1AFFFFFF" />

    <!-- ===== SUPERBAR PINNED LOGIC: pinned icons transparent at rest ===== -->
    <SolidColorBrush x:Key="TaskButtonOuterBorderPinned" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerBorderPinned" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerTopRightBorderPinned" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerBottomLeftBorderPinned" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonBackgroundPinned" Color="Transparent" />


    <!-- Hover: overlay chiaro piatto, nessun glow -->
    <SolidColorBrush x:Key="TaskButtonOuterBorderHover" Color="#8FFFFFFF" />
    <SolidColorBrush x:Key="TaskButtonInnerBorderHover" Color="#54FFFFFF" />
    <SolidColorBrush x:Key="TaskButtonInnerTopRightBorderHover" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerBottomLeftBorderHover" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonBackgroundHover" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="TaskButtonBottomBackgroundHover" Color="Transparent" />

    <!-- Active: overlay blu accent piatto (l'accent color e' il tratto
         distintivo dell'evidenziazione in Win8.1, al posto del vetro scuro
         "finestra aperta" di Win7) -->
    <SolidColorBrush x:Key="TaskButtonOuterBorderActive" Color="#FF4A7FDA" />
    <SolidColorBrush x:Key="TaskButtonInnerBorderActive" Color="#E02A5AE0" />
    <SolidColorBrush x:Key="TaskButtonInnerTopRightBorderActive" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerBottomLeftBorderActive" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonBackgroundActive" Color="#CC1E3A5F" />
    <SolidColorBrush x:Key="TaskButtonBottomBackgroundActive" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="TaskButtonBottomBackgroundActiveHover" Color="#FF6ACBFF" />
    <SolidColorBrush x:Key="TaskButtonBackgroundActiveHover" Color="#D6284A78" />
    <!-- La "barretta" di accent sotto l'icona attiva resta, ma piatta: nessuna
         sfumatura a piu' fermate che simula la luce che rimbalza sul vetro. -->
    <SolidColorBrush x:Key="TaskButtonBottomHighlightActive" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="TaskButtonBottomHighlightActiveHover" Color="#FF6ACBFF" />

    <!-- Pressed: overlay scuro piatto -->
    <SolidColorBrush x:Key="TaskButtonBackgroundPressed" Color="#701A2230" />

    <!-- Flashing: overlay ambra piatto (stesso intento cromatico del tema
         Win7, senza glow radiale ne' rampa a 3 fermate) -->
    <SolidColorBrush x:Key="TaskButtonOuterBorderFlashing" Color="#66F8B64A" />
    <SolidColorBrush x:Key="TaskButtonInnerBorderFlashing" Color="#46A66D14" />
    <SolidColorBrush x:Key="TaskButtonInnerTopRightBorderFlashing" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerBottomLeftBorderFlashing" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonBackgroundFlashing" Color="#D0FEC512" />
    <SolidColorBrush x:Key="TaskButtonBottomBackgroundFlashing" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonFlashPulseOverlay" Color="#2EFEDC5E" />

    <LinearGradientBrush x:Key="TaskButtonThumbnailBackground"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#77eeeeee"
                      Offset="0.0" />
        <GradientStop Color="#77bbbbbb"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TaskButtonThumbnailBorder"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#aa111111"
                      Offset="0.0" />
        <GradientStop Color="#dd111111"
                      Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TaskButtonThumbnailInnerBorder" Color="#88ffffff" />
    <SolidColorBrush x:Key="TaskButtonThumbnailThumbBorder" Color="#aa000000" />
    <DropShadowEffect x:Key="TaskButtonThumbnailShadow"
                      Color="Black"
                      ShadowDepth="1"
                      Direction="270"
                      Opacity="1"
                      BlurRadius="6" />

    <SolidColorBrush x:Key="ToolbarButtonInnerBorderHover" Color="#40ffffff" />
    <RadialGradientBrush x:Key="ToolbarButtonBottomBackgroundHover"
                         GradientOrigin="0.5,1.0"
                         RadiusX="0.5"
                         RadiusY="0.8">
        <GradientStop Color="#10a5c4"
                      Offset="0.0" />
        <GradientStop Color="#0010a5c4"
                      Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="ToolbarButtonBackgroundHover"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#48728e"
                      Offset="0.0" />
        <GradientStop Color="#36677d"
                      Offset="0.5" />
        <GradientStop Color="#034f6d"
                      Offset="0.5" />
        <GradientStop Color="#0c7e99"
                      Offset="1.0" />
    </LinearGradientBrush>

    <!-- v1.21.22 - skin 8.1: frecce di scorrimento squadrate. -->
    <CornerRadius x:Key="TaskListScrollUpCornerRadius">0,0,0,0</CornerRadius>
    <CornerRadius x:Key="TaskListScrollDownCornerRadius">0,0,0,0</CornerRadius>
    <CornerRadius x:Key="TaskListScrollLeftCornerRadius">0,0,0,0</CornerRadius>
    <CornerRadius x:Key="TaskListScrollRightCornerRadius">0,0,0,0</CornerRadius>

    <!-- v1.21.22b - skin 8.1: tessere di hover, sfondo premuto e alone del
         pulsante sono rettangolari, come il resto del chrome 8.1. -->
    <CornerRadius x:Key="SuperbarButtonOuterCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="SuperbarButtonInnerCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="SuperbarHoverTileCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="SuperbarGlowCornerRadius">0</CornerRadius>

    <SolidColorBrush x:Key="TaskListScrollButtonOuterBorder" Color="#99000000" />
    <SolidColorBrush x:Key="TaskListScrollButtonBorder" Color="#998c9ccc" />
    <SolidColorBrush x:Key="TaskListScrollButtonInnerBorderHover" Color="#ccd1def7" />
    <SolidColorBrush x:Key="TaskListScrollButtonInnerBorderPressed" Color="#aad1def7" />
    <SolidColorBrush x:Key="TaskListScrollButtonBackground" Color="#99121319" />
    <SolidColorBrush x:Key="TaskListScrollArrow" Color="#a2a2a5" />
    <SolidColorBrush x:Key="TaskListScrollArrowHover" Color="#ffffff" />

    <LinearGradientBrush x:Key="ToolbarThumbFill"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#AAFFFFFF"
                      Offset="0.3" />
        <GradientStop Color="#AA000000"
                      Offset="0.4" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ItemButtonForeground" Color="#ffffff" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#ffffff" />
    <SolidColorBrush x:Key="ButtonActiveForeground" Color="#ffffff" />
    <SolidColorBrush x:Key="ButtonPressedForeground" Color="#ffffff" />
    <SolidColorBrush x:Key="ButtonFlashingForeground" Color="#ffffff" />
    <SolidColorBrush x:Key="ClockForeground" Color="#ffffff" />
    <SolidColorBrush x:Key="InputLanguageForeground" Color="#ffffff" />
    <SolidColorBrush x:Key="InputLanguageBackground" Color="Transparent" />
    <SolidColorBrush x:Key="InputLanguageSelectorForeground" Color="#000000" />

    <LinearGradientBrush x:Key="ShowDesktopButtonBorderHorizontal"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#FFB3B3B3"
                      Offset="0.0" />
        <GradientStop Color="#FF000000"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShowDesktopButtonBorderVertical"
                         StartPoint="0,0"
                         EndPoint="1,0">
        <GradientStop Color="#FFB3B3B3"
                      Offset="0.0" />
        <GradientStop Color="#FF000000"
                      Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ToolTipBackground"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#D91B243D"
                      Offset="0.0" />
        <GradientStop Color="#F2202C48"
                      Offset="0.5" />
        <GradientStop Color="#E61A2340"
                      Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ToolTipBalloonBottomBackground" Color="#e4e5f0" />
    <SolidColorBrush x:Key="ToolTipBalloonForeground" Color="#000000" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolTipBorder" Color="#82FFFFFF" />
    <!-- Vista-Aero-XAML tooltip colors on dedicated keys, so the dark Win7
         tray balloons (which reference ToolTipBackground/Foreground above)
         keep their current look untouched. -->
    <LinearGradientBrush x:Key="VistaToolTipBackground"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#ffffff"
                      Offset="0.0" />
        <GradientStop Color="#e4e5f0"
                      Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="VistaToolTipForeground" Color="#575757" />
    <SolidColorBrush x:Key="VistaToolTipBorder" Color="#767676" />
    <SolidColorBrush x:Key="BalloonCloseButtonInactiveForeground" Color="#969696" />

